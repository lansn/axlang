// TRY-3.ax —— 只写 finally 不能吞掉错误；显式 `try` 后缀与隐式展开等价

result<int> may_fail(int n) {
    if n < 0 {
        throw error.Invalid("负数")
    }
    return ok(n)
}

result<int> wrapper(int n) {
    try {
        int v = may_fail(n)
        return ok(v + 1)
    } finally {
        print("wrapper finally（{n}）")
    }
}

int main() {
    // 1) 只有 finally 没有 catch：错误"过一手"后必须继续交给调用方
    match wrapper(-1) {
        ok(v) => print("不该 ok {v}"),
        fail(e) => print("调用方收到：{e.msg}"),
    }

    // 2) 同一个 try 块里，显式后缀与隐式展开效果一致
    try {
        int a = may_fail(2) try
        int b = may_fail(3)
        print("{a} 和 {b}")
    } catch (error e) {
        print("不该到这里：{e.msg}")
    }
    return 0
}
