// TRY-4.ax —— 循环写在 try 块内部时，块内 break 合法（没有跨出 try 边界）
//
// E6013 判的是"目标循环在不在块内"，不是"有没有 break"：
// 这里的 break 只跳出 try 内部的 for，finally 照常执行。

int main() {
    try {
        for i in 0..5 {
            if i == 2 {
                break
            }
            print("i={i}")
        }
    } catch (error e) {
        print("不该到这里：{e.msg}")
    } finally {
        print("finally 照常执行")
    }

    try {
        for i in 0..3 {
            if i == 1 {
                continue
            }
            print("c={i}")
        }
    } finally {
        print("continue 版也照常收尾")
    }
    return 0
}
