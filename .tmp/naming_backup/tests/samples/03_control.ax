// 03_control.ax —— 唯一的循环是 for，唯一的条件分支是 if / match
//
// 语言刻意没有 while、do-while、goto：
//   条件循环就写 `for { ... if 条件 { break } ... }`
//
//   axc run samples/03_control.ax

int main() {
    // ---- if / else if / else（分支体即使只有一条语句也必须带 {}）----
    int score = 76
    if score >= 90 {
        print("A")
    } else if score >= 75 {
        print("B")
    } else {
        print("C")
    }

    // ---- 区间遍历：0..n 是半开，0..=n 是闭区间 ----
    int sum = 0
    for i in 0..5 {
        sum = sum + i
    }
    print("0..5 求和 = {sum}")

    int sum2 = 0
    for i in 1..=5 {
        sum2 = sum2 + i
    }
    print("1..=5 求和 = {sum2}")

    // ---- 数组遍历 ----
    int[] nums = [3, 1, 4, 1, 5]
    int total = 0
    for x in nums {
        total = total + x
    }
    print("数组求和 = {total}")

    // ---- continue / break ----
    int odd = 0
    for x in nums {
        if x % 2 == 0 {
            continue
        }
        odd = odd + 1
    }
    print("奇数个数 = {odd}")

    // ---- 标签：从内层直接跳外层 ----
    int found = -1
    outer: for i in 0..3 {
        for j in 0..3 {
            if i * 3 + j == 5 {
                found = i * 3 + j
                break outer
            }
        }
    }
    print("找到 = {found}")

    // ---- 无头 for + break：等价于别的语言的 while ----
    int n = 0
    for {
        n = n + 1
        if n >= 3 {
            break
        }
    }
    print("循环了 {n} 次")
    return 0
}
