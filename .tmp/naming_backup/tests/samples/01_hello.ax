// 01_hello.ax —— 变量、字符串插值、格式化
//
//   axc run samples/01_hello.ax

int main() {
    string name = "axlang"
    int year = 2026
    decimal price = 19.99d

    print("你好，{name}！")
    print("今年是 {year} 年")
    print("价格 {price:.2} 元")          // .2 = 保留两位小数
    print("原样输出大括号：{{name}}")     // {{ }} 是转义

    // 字符串没有 char 类型，遍历出来的是长度 1 的 string
    int n = 0
    for c in "中文" {
        n = n + 1
        print("第 {n} 个字符：{c}")
    }

    // 字节长度 vs 字符个数：一个汉字 3 字节
    print("字符数 {n}，字节数 {"中文".byte_len()}")
    return 0
}
