// 11_try_catch.ax —— 就地捕获错误：try / catch / finally
//
// 05_result.ax 讲的是"用 match 分类处理"；这里讲"在一段代码里就地捕获"。
// 二者是同一套错误模型（result<T>）的两种用法，没有第二套异常机制：
//   · 块内 result<T> 在需要 T 的位置自动展开，失败即跳到本块的 catch
//   · catch 按 error 变体过滤，catch (error e) 兜底且必须写在最后
//   · finally 无论成功、被捕获、还是继续往外抛，都会执行
//
//   axc run samples/11_try_catch.ax

result<int> parse_and_double(string s) {
    int n = int.parse(s) try                // 不在 try 块里，用后缀把失败交给调用方
    if n < 0 {
        throw error.Invalid("不能是负数：{n}")
    }
    return ok(n * 2)
}

result<int> load(string raw) {
    try {
        int v = parse_and_double(raw)       // 失败 → 跳到本块 catch
        print("解析成功：{raw} -> {v}")
        return ok(v)
    } catch (error.Invalid e) {
        print("参数不合法：{e.msg}")
        throw error.Money("上游要的是钱相关的错：{e.msg}")   // 本层不重捕获，先跑 finally
    } finally {
        print("load finally（{raw}）")
    }
}

int main() {
    // 1) 成功路径
    match load("21") {
        ok(v) => print("main 收到 {v}"),
        fail(e) => print("main 收到失败：{e.msg}"),
    }

    // 2) 解析失败（Invalid）→ 内层改写成 Money → 外层兜底 catch 接住
    try {
        int a = load("abc")
        print("不会到这里 {a}")
    } catch (error e) {
        print("外层兜底：{e.msg}")
    } finally {
        print("外层 finally")
    }

    // 3) 只写 finally 不写 catch：错误不被处理，继续往外，finally 照样执行
    try {
        try {
            int b = load("-3")
            print("不会到这里 {b}")
        } finally {
            print("内层只写 finally")
        }
    } catch (error.Money e) {
        print("外层接到 Money：{e.msg}")
    }

    // 4) defer 是块级清理，先于 catch 执行
    try {
        defer print("defer：离开 try 块")
        throw error.IO("文件读不到")
    } catch (error.IO e) {
        print("catch 接住：{e.msg}")
    } finally {
        print("finally：最后一个")
    }

    print("全部结束")
    return 0
}
