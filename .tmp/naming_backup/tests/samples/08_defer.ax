// 08_defer.ax —— defer：按登记的逆序执行，return / throw 也会执行
//
// 用来配对"申请-释放"，不必在每个 return 前手写清理。
//
//   axc run samples/08_defer.ax

void work(string tag) {
    defer print("[{tag}] 释放资源")
    defer print("[{tag}] 关闭文件")
    print("[{tag}] 开始工作")
    // 函数结束时：先"关闭文件"，再"释放资源"（逆序）
}

result<int> may_fail(bool bad) {
    defer print("  清理：无论如何都执行")
    if bad {
        throw error.IO("读失败了")
    }
    return ok(1)
}

int main() {
    work("A")

    match may_fail(false) {
        ok(v) => print("  正常返回 {v}"),
        fail(e) => print("  失败 {e.msg}"),
    }

    match may_fail(true) {
        ok(v) => print("  正常返回 {v}"),
        fail(e) => print("  失败 {e.msg}"),
    }
    return 0
}
