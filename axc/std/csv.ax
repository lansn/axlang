// axc/std/csv.ax —— axlang 标准库 csv 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go encoding/csv。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 camelCase 风格，如 readAll / write。
// ax 代码中通过 std.csv.readAll(...) 调用模块级函数。

extern "C" {
    string[][] ax_csv_read_all(File f);
    int ax_csv_write(File f, string[] record);
}

// ---------- 模块级函数（camelCase 命名） ----------

/**
 * 函数名：readAll
 * 功能：读取 CSV 文件 r 的全部记录
 * 输入参数：r (File) - CSV 文件句柄
 * 输出参数：string[][] - 二维字符串数组，每行一个记录，每列一个字段
 * 修订日期：2026-11-27
 */
public string[][] readAll(File r) {
    unsafe {
        return ax_csv_read_all(r)
    }
}

/**
 * 函数名：write
 * 功能：将一条记录写入 CSV 文件 w
 * 输入参数：w (File) - CSV 文件句柄；record (string[]) - 要写入的一条记录
 * 输出参数：int - 0 表示成功，非 0 表示失败
 * 修订日期：2026-11-27
 */
public int write(File w, string[] record) {
    unsafe {
        return ax_csv_write(w, record)
    }
}
