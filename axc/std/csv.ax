// axc/std/csv.ax —— axlang 标准库 csv 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go encoding/csv。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 C 风格：全部小写，下划线分隔，如 csv_read_all / csv_write。
// ax 代码中通过 std.csv.read_all(...) 调用模块级函数。

extern "C" {
    string[][] ax_csv_read_all(File f);
    int ax_csv_write(File f, string[] record);
}

// ---------- 模块级函数（C 风格命名：小写 + 下划线） ----------

public string[][] read_all(File r) {
    unsafe {
        return ax_csv_read_all(r)
    }
}

public int write(File w, string[] record) {
    unsafe {
        return ax_csv_write(w, record)
    }
}
