// axc/std/env.ax —— axlang 标准库 env 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go os 环境变量增值功能。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 注：std.os 已提供 getenv/setenv/unsetenv/environ 基础环境变量操作，
// std.env 互补提供展开、清除、存在性判断、全部枚举等增值功能。
//
// 导出函数命名采用 camelCase 风格，如 expand / clearenv / exists / all。
// ax 代码中通过 std.env.expand(...) 调用模块级函数。

extern "C" {
    /* axrt env 原语（axc/rt/env/axrt_env.c） */
    string ax_env_expand(string s);
    int    ax_env_clearenv();
    int    ax_env_exists(string key);
    string[] ax_env_all();
}

// ---------- 模块级函数（camelCase 命名） ----------

/**
 * 函数名：expand
 * 功能：展开字符串中的环境变量引用（$VAR 或 ${VAR}，对标 Go os.ExpandEnv）
 * 输入参数：s (string) - 待展开的字符串
 * 输出参数：string - 展开后的字符串；未设置的变量展开为空字符串
 * 修订日期：2026-11-29
 */
public string expand(string s) {
    unsafe {
        return ax_env_expand(s)
    }
}

/**
 * 函数名：clearenv
 * 功能：清除所有环境变量（对标 Go os.Clearenv）
 * 输入参数：无
 * 输出参数：int - 0 表示成功，非 0 表示失败
 * 修订日期：2026-11-29
 */
public int clearenv() {
    unsafe {
        return ax_env_clearenv()
    }
}

/**
 * 函数名：exists
 * 功能：判断环境变量是否存在
 * 输入参数：key (string) - 环境变量名
 * 输出参数：int - 1 表示存在，0 表示不存在
 * 修订日期：2026-11-29
 */
public int exists(string key) {
    unsafe {
        return ax_env_exists(key)
    }
}

/**
 * 函数名：all
 * 功能：返回所有环境变量 "KEY=VALUE" 数组（对标 Go os.Environ）
 * 输入参数：无
 * 输出参数：string[] - 所有环境变量，每项为 "KEY=VALUE"
 * 修订日期：2026-11-29
 */
public string[] all() {
    unsafe {
        return ax_env_all()
    }
}
