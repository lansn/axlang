// axc/std/rand.ax —— axlang 标准库 rand 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go math/rand。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 camelCase 风格，如 randInt / randFloat / seed。
// ax 代码中通过 std.rand.randInt(...) 调用模块级函数。

extern "C" {
    int ax_rand_int(int n);
    float ax_rand_float();
    void ax_rand_seed(int seed);
}

// ---------- 模块级函数（camelCase 命名） ----------

/**
 * 函数名：randInt
 * 功能：返回 [0, n) 范围内的随机整数
 * 输入参数：n (int) - 上限（不包含）
 * 输出参数：int - [0, n) 范围内的随机整数
 * 修订日期：2026-11-28
 */
public int randInt(int n) {
    unsafe {
        return ax_rand_int(n)
    }
}

/**
 * 函数名：randFloat
 * 功能：返回 [0.0, 1.0) 范围内的随机浮点数
 * 输入参数：无
 * 输出参数：float - [0.0, 1.0) 范围内的随机浮点数
 * 修订日期：2026-11-28
 */
public float randFloat() {
    unsafe {
        return ax_rand_float()
    }
}

/**
 * 函数名：seed
 * 功能：设置随机数生成器的种子
 * 输入参数：seed (int) - 随机种子
 * 输出参数：无
 * 修订日期：2026-11-28
 */
public void seed(int seed) {
    unsafe {
        ax_rand_seed(seed)
    }
}
