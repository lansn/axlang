// axc/std/os.ax —— axlang 标准库 os 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go os / C stdlib。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 C 风格：全部小写，下划线分隔，如 getenv / setenv。
// ax 代码中通过 std.os.getenv(...) 调用模块级函数。
//
// 注：os.args() / os.environ() 返回 string[] 数组，涉及 ax_arr 返回值，
// 当前 ax 源码层先不独立包装，可继续沿用内建模块或后续补齐。

extern "C" {
    string ax_os_getenv(string name);
    string ax_os_user_home_dir();
    void ax_os_exit(int code);
    string ax_os_getwd();
    int ax_os_chdir(string path);
    int ax_os_getpid();
    int ax_os_getppid();
    string ax_os_hostname();
    int ax_os_setenv(string name, string value);
    int ax_os_unsetenv(string name);

    /* os 扩展（对标 Go os.UserCacheDir 等） */
    string ax_os_user_cache_dir();
    int ax_os_getpagesize();
    int ax_os_getuid();
    int ax_os_getgid();
    int ax_os_geteuid();
    int ax_os_getegid();
    int[] ax_os_getgroups();
    string ax_os_executable();
}

// ---------- 模块级函数（C 风格命名：小写 + 下划线） ----------

/**
 * 函数名：getenv
 * 功能：获取环境变量 name 的值
 * 输入参数：name (string) - 环境变量名
 * 输出参数：string - 环境变量值，未设置返回空字符串
 * 修订日期：2026-11-27
 */
public string getenv(string name) {
    unsafe {
        return ax_os_getenv(name)
    }
}

/**
 * 函数名：userHomeDir
 * 功能：返回当前用户的主目录路径
 * 输入参数：无
 * 输出参数：string - 用户主目录路径
 * 修订日期：2026-11-27
 */
public string userHomeDir() {
    unsafe {
        return ax_os_user_home_dir()
    }
}

/**
 * 函数名：exit
 * 功能：以退出码 code 终止当前进程
 * 输入参数：code (int) - 退出码
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void exit(int code) {
    unsafe {
        ax_os_exit(code)
    }
}

/**
 * 函数名：getwd
 * 功能：返回当前工作目录路径
 * 输入参数：无
 * 输出参数：string - 当前工作目录路径
 * 修订日期：2026-11-27
 */
public string getwd() {
    unsafe {
        return ax_os_getwd()
    }
}

/**
 * 函数名：chdir
 * 功能：将当前工作目录切换为 path
 * 输入参数：path (string) - 目标目录路径
 * 输出参数：int - 0 表示成功，非 0 表示失败
 * 修订日期：2026-11-27
 */
public int chdir(string path) {
    unsafe {
        return ax_os_chdir(path)
    }
}

/**
 * 函数名：getpid
 * 功能：返回当前进程 ID
 * 输入参数：无
 * 输出参数：int - 当前进程 ID
 * 修订日期：2026-11-27
 */
public int getpid() {
    unsafe {
        return ax_os_getpid()
    }
}

/**
 * 函数名：getppid
 * 功能：返回当前进程的父进程 ID
 * 输入参数：无
 * 输出参数：int - 父进程 ID
 * 修订日期：2026-11-27
 */
public int getppid() {
    unsafe {
        return ax_os_getppid()
    }
}

/**
 * 函数名：hostname
 * 功能：返回主机名
 * 输入参数：无
 * 输出参数：string - 主机名
 * 修订日期：2026-11-27
 */
public string hostname() {
    unsafe {
        return ax_os_hostname()
    }
}

/**
 * 函数名：setenv
 * 功能：设置环境变量 name 为 value
 * 输入参数：name (string) - 环境变量名；value (string) - 环境变量值
 * 输出参数：int - 0 表示成功，非 0 表示失败
 * 修订日期：2026-11-27
 */
public int setenv(string name, string value) {
    unsafe {
        return ax_os_setenv(name, value)
    }
}

/**
 * 函数名：unsetenv
 * 功能：删除环境变量 name
 * 输入参数：name (string) - 环境变量名
 * 输出参数：int - 0 表示成功，非 0 表示失败
 * 修订日期：2026-11-27
 */
public int unsetenv(string name) {
    unsafe {
        return ax_os_unsetenv(name)
    }
}

/**
 * 函数名：userCacheDir
 * 功能：返回当前用户的缓存目录路径
 * 输入参数：无
 * 输出参数：string - 用户缓存目录路径
 * 修订日期：2026-11-27
 */
public string userCacheDir() {
    unsafe {
        return ax_os_user_cache_dir()
    }
}

/**
 * 函数名：getpagesize
 * 功能：返回系统页面大小（字节）
 * 输入参数：无
 * 输出参数：int - 系统页面大小（字节）
 * 修订日期：2026-11-27
 */
public int getpagesize() {
    unsafe {
        return ax_os_getpagesize()
    }
}

/**
 * 函数名：getuid
 * 功能：返回当前用户 ID
 * 输入参数：无
 * 输出参数：int - 当前用户 ID
