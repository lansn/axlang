/**
 * 函数名：getegid
 * 功能：返回当前有效组 ID
 * 输入参数：无
 * 输出参数：int - 当前有效组 ID
 * 修订日期：2026-11-27
 */
public int getegid() {
    unsafe {
        return ax_os_getegid()
    }
}

/**
 * 函数名：getgroups
 * 功能：返回当前用户所属的组 ID 列表
