// axc/std/json.ax —— axlang 标准库 json 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go encoding/json。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 C 风格：全部小写，下划线分隔，如 stringify / valid。
// ax 代码中通过 std.json.stringify(...) 调用模块级函数。
//
// 注：json.parse 返回 result<map<string, object>>，涉及运行时结果类型，
// 当前 ax 源码层先不独立包装，可继续沿用内建模块或后续补齐。

extern "C" {
    string ax_json_stringify(object v);
    string ax_json_marshal_indent(object v, string prefix, string indent);
    int ax_json_valid(string s);
}

// ---------- 模块级函数（C 风格命名：小写 + 下划线） ----------

public string stringify(object v) {
    unsafe {
        return ax_json_stringify(v)
    }
}

public string marshal_indent(object v, string prefix, string indent) {
    unsafe {
        return ax_json_marshal_indent(v, prefix, indent)
    }
}

public int valid(string s) {
    unsafe {
        return ax_json_valid(s)
    }
}
