// 裸类型名（文稿 9.2）：`import model` 之后直接写 Product / Point / Color，
// 不必每次拼 `model.Product`；全路径与末段短名同样合法。
import model

int main() {
    Product p = new Product("裸名", 10.00d)      // 类型标注 + new 都是裸名
    Println(p.Label())

    Product s = Product.Sample()                // 静态方法：裸类名 + 方法
    Println(s.Label())

    Point pt = Point(3, 4)                      // struct 位置构造
    Println("{pt.x},{pt.y}")

    Color c = Color.Red                         // enum 裸名
    Println("{c}")

    model.Product q = new model.Product("短名", 1.50d)   // 旧写法照旧可用
    Println(q.Label())
    return 0
}
