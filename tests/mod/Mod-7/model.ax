// 模块 model：导出一个 class、一个 struct、一个 enum
public class Product {
    public string name
    public decimal price

    constructor(string name, decimal price) {
        this.name = name
        this.price = price
    }

    public string label() {
        return "{this.name} {this.price:.2}"
    }

    public static Product sample() {
        return new Product("样品", 0.00d)
    }
}

public struct Point {
    int x
    int y
}

public enum Color {
    red,
    green,
}
