import utils
import utils as u                  // 别名：同一模块的另一个视图
import net.http

int main() {
    int s = utils.add(2, 3)
    println("add = {s}")
    println("MAX = {utils.MAX}")
    println("double = {utils.double_it(21)}")

    utils.Calc c = utils.Calc(5)
    println("twice = {c.twice()}")
    utils.Calc z = utils.Calc.zero()
    println("zero base = {z.base}")

    println("alias add = {u.add(1, 1)}")
    println("http get = {net.http.get()}")
    return 0
}
