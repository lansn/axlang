// 模块 utils：演示导出与私有（文稿 9.1）
public const int MAX = 100

const int HIDDEN = 1              // 私有：模块外不可见

public int add(int a, int b) {
    return a + b
}

int helper(int x) {               // 私有函数：仅模块内可用
    return x * 2
}

public int double_it(int x) {
    return helper(x)              // 模块内裸名调用私有函数
}

public class Calc {
    public int Base
    constructor(int base) {
        this.Base = base
    }
    public static Calc Zero() {
        return new Calc(0)
    }
    public int Twice() {
        return this.Base * 2
    }
}
