// GX-CrossMod：跨模块泛型约束正例。
// Drawable 接口定义在 model 模块，main 模块导入后将其用作泛型约束 T: Drawable。
// 这验证 check_generic_constraints 改用 lookup_type_name 后可解析跨模块导入的 interface。

import model

string draw<T: Drawable>(T x) {
    return x.draw()
}

int main() {
    model.Circle c = model.Circle(5)
    println(draw(c))
    return 0
}
