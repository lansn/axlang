public interface Describable {
    string describe()
}

public class Outer {
    public class Inner {
        public string value
        constructor(string v) {
            this.value = v
        }
    }
}

public class Base {
    public int x
    constructor(int x) {
        this.x = x
    }
    public string getName() {
        return "Base"
    }
}
