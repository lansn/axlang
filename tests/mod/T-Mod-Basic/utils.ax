// utils 模块
public int add(int a, int b) {
    return a + b
}

public const int MAX = 100

public int doubleIt(int x) {
    return x * 2
}

public class Calc {
    public int base
    constructor(int base) {
        this.base = base
    }
    public int twice() {
        return this.base * 2
    }
    public static Calc zero() {
        return new Calc(0)
    }
}
