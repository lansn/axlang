// 跨模块 interface 多态（GAP #13 回归）：interface 定义在 model 模块，
// 入口模块定义实现类并上转调用；派发经 (类, interface) shim 虚表。
import model

class TextDoc implement model.Describable {
    public string Title

    constructor(string title) {
        this.Title = title
    }

    public string Describe() {
        return "文档：{this.Title}"
    }
}

class SecretDoc extend TextDoc {
    constructor() {
        parent("机密文档")
    }

    public override string Describe() {
        return "机密：***"
    }
}

int main() {
    model.Describable d = new TextDoc("年度报告")   // 跨模块 interface 上转
    println(d.Describe())

    d = new SecretDoc()                             // 子类实例赋同一 interface
    println(d.Describe())                           // 派发到 override 实现

    println(model.Show(d))                          // interface 作跨模块参数
    return 0
}
