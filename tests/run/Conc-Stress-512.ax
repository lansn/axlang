// ============================================================================
// axlang 32 线程共享队列压力测试 —— Conc-Stress-512
// 验证：32 个生产者线程并发 Push 到同一个 queue<int>，主线程 Pop 汇总
// 期望总数：32 * 5000 = 160000
// 设计：主线程用 TryPop 非阻塞消费直到计数达标，再 Close 并 Join 所有线程
// ============================================================================

void producer(queue<int> q) {
    for i in 0..5000 {
        q.push(i)
    }
}

int main() {
    queue<int> q = queue<int>()

    var t1 = thread(producer, q)
    var t2 = thread(producer, q)
    var t3 = thread(producer, q)
    var t4 = thread(producer, q)
    var t5 = thread(producer, q)
    var t6 = thread(producer, q)
    var t7 = thread(producer, q)
    var t8 = thread(producer, q)
    var t9 = thread(producer, q)
    var t10 = thread(producer, q)
    var t11 = thread(producer, q)
    var t12 = thread(producer, q)
    var t13 = thread(producer, q)
    var t14 = thread(producer, q)
    var t15 = thread(producer, q)
    var t16 = thread(producer, q)
    var t17 = thread(producer, q)
    var t18 = thread(producer, q)
    var t19 = thread(producer, q)
    var t20 = thread(producer, q)
    var t21 = thread(producer, q)
    var t22 = thread(producer, q)
    var t23 = thread(producer, q)
    var t24 = thread(producer, q)
    var t25 = thread(producer, q)
    var t26 = thread(producer, q)
    var t27 = thread(producer, q)
    var t28 = thread(producer, q)
    var t29 = thread(producer, q)
    var t30 = thread(producer, q)
    var t31 = thread(producer, q)
    var t32 = thread(producer, q)

    // 期望 32 * 5000 = 160000
    int expected = 160000
    int count = 0

    // 非阻塞消费直到收齐所有项（生产者推入的同时主线程拉出）
    while count < expected {
        int? v = q.tryPop()
        if v != null {
            count = count + 1
        }
    }

    // 所有项已消费，关闭队列并等待生产者线程结束
    q.close()

    t1.join()
    t2.join()
    t3.join()
    t4.join()
    t5.join()
    t6.join()
    t7.join()
    t8.join()
    t9.join()
    t10.join()
    t11.join()
    t12.join()
    t13.join()
    t14.join()
    t15.join()
    t16.join()
    t17.join()
    t18.join()
    t19.join()
    t20.join()
    t21.join()
    t22.join()
    t23.join()
    t24.join()
    t25.join()
    t26.join()
    t27.join()
    t28.join()
    t29.join()
    t30.join()
    t31.join()
    t32.join()

    // 排空可能残留的项（理论上应为空）
    int? v2 = null
    v2 = q.pop()
    while v2 != null {
        count = count + 1
        v2 = q.pop()
    }

    bool ok = (count == expected)
    println("count={count}")
    println("expected={expected}")
    println("ok={ok}")
    println("Conc-Stress-512 done")
    return 0
}
