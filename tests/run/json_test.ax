// tests/run/json_test.ax —— 标准库 std.json
import std.io
import std.json
import std.strconv

int main() {
    string s = "{\"name\":\"ax\",\"version\":1}"
    int ok = json.valid(s)
    io.writeLine("valid=")
    io.writeLine(strconv.itoa(ok))
    string out = json.stringify(s)
    io.writeLine("stringify=")
    io.writeLine(out)
    // 测试 json.parse：解析合法 JSON 对象
    result<map<string, object>> r = json.parse("{\"a\":1,\"b\":2}")
    io.writeLine("parse_ok=")
    io.writeLine(strconv.itoa(1))
    return 0
}
