// ============================================================================
// axlang 多线程安全测试 —— ThreadSafe-3
// 验证：多个 defer 在线程内的逆序执行语义（LIFO，后注册先执行）
//
// 设计：
//   3 个线程，每个线程独立 queue<int>，在线程函数内按顺序注册
//   `defer q.Push(1)`、`defer q.Push(2)`、`defer q.Push(3)`。
//   线程退出时 defer 逆序执行：Push(3) → Push(2) → Push(1)。
//   队列是 FIFO，主线程 Pop 应该得到 3, 2, 1。
//
//   若 defer 按注册顺序（FIFO）执行，Pop 得到 1, 2, 3，测试失败。
//
// 注意：queue<int> 是所有权类型，每个线程独立队列，避免所有权移动冲突。
// defer 中不能直接 Push 字面量（会生成取字面量地址的非法 C 代码），
// 需先赋给局部变量再 Push。
// ============================================================================

// 线程工作函数：按顺序注册 3 个 defer，线程退出时逆序执行
void worker(queue<int> q) {
    int a = 1
    int b = 2
    int c = 3
    defer q.Push(a)   // 第 1 个注册，最后执行
    defer q.Push(b)   // 第 2 个注册，中间执行
    defer q.Push(c)   // 第 3 个注册，第一个执行
}

int main() {
    // 3 个线程，每个独立队列
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()

    var t1 = thread(worker, q1)
    var t2 = thread(worker, q2)
    var t3 = thread(worker, q3)

    // 等待所有线程结束（此时所有 defer 已执行）
    t1.Join()
    t2.Join()
    t3.Join()

    // 分别 Pop 每个队列的 3 个值
    // 期望逆序：3, 2, 1
    int? v1_1 = q1.Pop()
    int? v1_2 = q1.Pop()
    int? v1_3 = q1.Pop()

    int? v2_1 = q2.Pop()
    int? v2_2 = q2.Pop()
    int? v2_3 = q2.Pop()

    int? v3_1 = q3.Pop()
    int? v3_2 = q3.Pop()
    int? v3_3 = q3.Pop()

    // 解包（若 null 则为 0，测试会因期望不匹配而失败）
    int n1_1 = 0
    if v1_1 != null {
        n1_1 = v1_1
    }
    int n1_2 = 0
    if v1_2 != null {
        n1_2 = v1_2
    }
    int n1_3 = 0
    if v1_3 != null {
        n1_3 = v1_3
    }

    int n2_1 = 0
    if v2_1 != null {
        n2_1 = v2_1
    }
    int n2_2 = 0
    if v2_2 != null {
        n2_2 = v2_2
    }
    int n2_3 = 0
    if v2_3 != null {
        n2_3 = v2_3
    }

    int n3_1 = 0
    if v3_1 != null {
        n3_1 = v3_1
    }
    int n3_2 = 0
    if v3_2 != null {
        n3_2 = v3_2
    }
    int n3_3 = 0
    if v3_3 != null {
        n3_3 = v3_3
    }

    // 验证每个队列都逆序得到 3, 2, 1
    bool ok1 = (n1_1 == 3 && n1_2 == 2 && n1_3 == 1)
    bool ok2 = (n2_1 == 3 && n2_2 == 2 && n2_3 == 1)
    bool ok3 = (n3_1 == 3 && n3_2 == 2 && n3_3 == 1)
    bool ok = (ok1 && ok2 && ok3)

    println("q1={n1_1},{n1_2},{n1_3}")
    println("q2={n2_1},{n2_2},{n2_3}")
    println("q3={n3_1},{n3_2},{n3_3}")
    println("ok1={ok1}")
    println("ok2={ok2}")
    println("ok3={ok3}")
    println("ok={ok}")
    println("ThreadSafe-3 done")
    return 0
}
