// TRY-1.ax —— try/catch/finally：块内失败就地捕获，finally 一定执行
//
// 块内 `result<T>` 在需要 T 的位置自动展开（等价于补了 `try`），
// 失败不再返回调用方，而是跳到本块的 catch 链。

result<int> divide(int a, int b) {
    if b == 0 {
        throw error.Invalid("除数不能是 0")
    }
    return ok(a / b)
}

int main() {
    // 1) 隐式展开失败 → 按 error 变体选 catch，其余 catch 跳过
    try {
        int x = divide(10, 0)
        println("不会走到这里 {x}")
    } catch (error.Money e) {
        println("钱不够：{e.msg}")
    } catch (error.Invalid e) {
        println("除数问题：{e.msg}")
    } catch (error e) {
        println("兜底：{e.msg}")
    } finally {
        println("收尾 1")
    }

    // 2) 正常路径：catch 全不触发，finally 照样执行
    try {
        int y = divide(9, 3)
        println("成功 {y}")
    } catch (error e) {
        println("不该到这里")
    } finally {
        println("收尾 2")
    }

    println("try 之后照常往下走")
    return 0
}
