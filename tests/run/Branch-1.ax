// 分支汇合与循环保守合并的正例（O-4/O-5 配套）：
// 两支状态互不泄漏、分支内复活、循环内每轮重赋值/新建都合法
bool yes() {
    return true
}

class Buf {
    public int n
    constructor(int n) {
        this.n = n
    }
    public void write(string s) {
        this.n = this.n + s.Len()
    }
}

void sink(Buf b) {
}

int main() {
    // 1) then 分支移走，else 分支内照常用——互不泄漏
    var a = new Buf(1)
    if yes() {
        sink(a)
    } else {
        a.write("x")
    }

    // 2) 分支内 move 后重新赋值复活
    var c = new Buf(2)
    if yes() {
        sink(c)
        c = new Buf(3)
        c.write("y")
    }

    // 3) 两支都没 move，汇合点照常用
    var d = new Buf(4)
    if yes() {
        d.write("a")
    } else {
        d.write("b")
    }
    d.write("c")

    // 4) 循环体内每轮重赋值再使用 → 合法
    var e = new Buf(0)
    for i in 0..3 {
        e = new Buf(i)
        e.write("x")
    }

    // 5) 循环体每轮新建局部对象再 move → 合法
    for i in 0..2 {
        var f = new Buf(i)
        sink(f)
    }

    // 6) for-in 的元素变量每轮重新绑定，每轮 move 合法
    string[] names = ["a", "b"]
    for s in names {
        var g = new Buf(s.Len())
        sink(g)
    }

    println("done {d.n}")
    return 0
}
