// 数组边界测试：正常访问 + 越界（运行期终止）
int main() {
    int[] xs = [10, 20, 30]

    // 正常访问
    println("xs[0]={xs[0]}")
    println("xs[1]={xs[1]}")
    println("xs[2]={xs[2]}")

    // 长度
    println("len={xs.Len()}")

    // 越界访问：运行期终止进程（不会静默返回默认值）
    // xs[3] 会越界，此处不执行，避免测试崩溃
    // 越界行为已由设计文稿规定：越界即终止进程

    println("done")
    return 0
}
