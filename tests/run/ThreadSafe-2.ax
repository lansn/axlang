// ============================================================================
// axlang 多线程安全测试 —— ThreadSafe-2
// 验证：defer 在线程函数内的确定性执行
//
// 设计：
//   4 个线程各持独立的 queue<int>，每个线程体内注册 `defer q.push(1)`。
//   主线程 Join 等待所有线程结束（线程函数返回时 defer 必须执行），
//   然后分别 Pop 每个队列，统计收到的非 null 值。
//   期望：收到 4 个 1，证明 4 个 defer 均已执行，无遗漏、无重复。
//
// 注意：queue<int> 是所有权类型，不能被多个 thread 共享同一指针，
// 故每个线程使用独立队列（与 Conc-Perf-1 的设计一致）。
//
// 输出确定性：不管线程调度顺序，每个线程恰好 Push 一次值 1，
// 主线程 Pop 出的值集合固定为 {1,1,1,1}，count 固定为 4。
// ============================================================================

// 线程工作函数：defer 注册 Push(val)，线程退出时必然执行
void worker(queue<int> q) {
    int val = 1
    defer q.push(val)
}

int main() {
    // 每个线程独立队列（避免所有权移动冲突）
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()
    queue<int> q4 = queue<int>()

    // 启动 4 个线程
    var t1 = thread(worker, q1)
    var t2 = thread(worker, q2)
    var t3 = thread(worker, q3)
    var t4 = thread(worker, q4)

    // 等待所有线程结束（此时每个线程的 defer 已执行）
    t1.join()
    t2.join()
    t3.join()
    t4.join()

    // 分别 Pop 每个队列，统计收到的值
    int count = 0
    int? v = null

    v = q1.pop()
    if v != null {
        count = count + v
    }
    v = q2.pop()
    if v != null {
        count = count + v
    }
    v = q3.pop()
    if v != null {
        count = count + v
    }
    v = q4.pop()
    if v != null {
        count = count + v
    }

    // 期望：4 个 defer 各 Push 一次 1，count == 4
    bool ok = (count == 4)
    println("count={count}")
    println("ok={ok}")
    println("ThreadSafe-2 done")
    return 0
}
