// File：Create → WriteLine → Read / ReadLine（文稿 11.3）
import file

int main() {
    var f = file.create("tests/.build/file-1.txt") try
    f.write_line("alpha") try
    f.write_line("第二行") try
    f.close()

    var g = file.open("tests/.build/file-1.txt") try
    string all = g.read() try
    print("全文=[{all}]")
    g.close()

    var h = file.open("tests/.build/file-1.txt") try
    string? l1 = h.read_line()
    if l1 != null {
        println("1={l1}")
    }
    string? l2 = h.read_line()
    if l2 != null {
        println("2={l2}")
    }
    string? l3 = h.read_line()
    if l3 == null {
        println("3=EOF")
    }
    h.close()

    var a = file.append("tests/.build/file-1.txt") try
    a.write_line("gamma") try
    a.close()

    var n = file.open("tests/.build/file-1.txt") try
    string all2 = n.read() try
    println("追加后=[{all2}]")
    n.close()
    return 0
}
