// 数组切片测试：m[lo..hi] 和 m[lo..=hi]
int main() {
    int[] xs = [10, 20, 30, 40, 50]

    // 左闭右开切片
    int[] a = xs[1..3]
    println("a len={a.Len()}")       // 2
    println("a={a}")                 // [20, 30]
    println("a[0]={a[0]} a[1]={a[1]}")  // 20 30

    // 左闭右闭切片
    int[] b = xs[0..=2]
    println("b len={b.Len()}")       // 3
    println("b={b}")                 // [10, 20, 30]

    // 从头开始切片
    int[] c = xs[0..2]
    println("c={c}")                 // [10, 20]

    // 到末尾切片
    int[] d = xs[3..5]
    println("d={d}")                 // [40, 50]

    // 空切片
    int[] e = xs[2..2]
    println("e len={e.Len()}")       // 0
    println("e={e}")                 // []

    // 整个数组切片
    int[] f = xs[0..5]
    println("f={f}")                 // [10, 20, 30, 40, 50]

    // 切片后修改原数组（浅层共享数据，切片会受影响）
    xs[1] = 99
    println("after modify a={a}")    // [99, 30]（浅层共享）

    return 0
}
