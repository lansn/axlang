// ============================================================================
// axlang 性能测试 —— Perf-1
// 验证：泛型单态化、FFI 零成本调用、数组遍历、移动语义零拷贝
// 注意：输出为确定性计算结果，时间指标未打印（避免非确定性比较）
// ============================================================================

// 泛型身份函数（单态化后为各类型生成专用代码）
T identity<T>(T x) {
    return x
}

// 泛型求和（借用，不移动所有权）
int sum_arr<T>(&const T[] xs) {
    int s = 0
    for i in 0..xs.len() {
        s = s + xs[i]
    }
    return s
}

// 普通求和（对比基准）
int sum_arr_plain(&const int[] xs) {
    int s = 0
    for i in 0..xs.len() {
        s = s + xs[i]
    }
    return s
}

// FFI：调用 C 的 puts（零成本，直接调用 C 函数名）
extern "C" {
    int puts(string s);
}

int ffi_once() {
    int r = 0
    unsafe {
        r = puts("ffi-ok")
    }
    return r
}

// 移动语义：大对象移动（零拷贝）
class BigObj {
    public int[] Data
    public int Tag
    constructor(int n) {
        this.Data = [0]
        this.Tag = n
    }
}

int move_perf(BigObj b) {
    return b.Tag
}

int main() {
    const int N = 500000

    // ---------- 测试 1：泛型单态化 vs 普通函数 ----------
    int[] xs = [0]
    for i in 1..N {
        xs.push(i)
    }

    int s1 = sum_arr(&xs)          // 泛型单态化版本（显式借用）
    int s2 = sum_arr_plain(&xs)    // 普通版本（显式借用）

    println("sum_arr      ={s1}")
    println("sum_arr_plain={s2}")

    // ---------- 测试 2：FFI 零成本调用（单次验证） ----------
    unsafe {
        int fr = ffi_once()
        println("ffi_once ret={fr}")
    }

    // ---------- 测试 3：移动语义零拷贝 ----------
    int mv_sum = 0
    for i in 0..10000 {
        BigObj o = new BigObj(100)
        int mv = move_perf(o)
        mv_sum = mv_sum + mv
    }
    println("10kx move BigObj(100) mv_sum={mv_sum}")

    // ---------- 测试 4：泛型 identity ----------
    int id_sum = 0
    for i in 0..N {
        int id = identity(i)
        id_sum = id_sum + id
    }
    println("500kx identity(int) id_sum={id_sum}")

    println("Perf-1 done")
    return 0
}
