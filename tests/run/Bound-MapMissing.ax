// map 边界测试：不存在的键
int main() {
    map<string, int> stock = {}
    stock["苹果"] = 5
    stock["香蕉"] = 3

    // 存在的键
    println("苹果={stock["苹果"]}")

    // 不存在的键：map 下标可能返回 0 或触发行为，视实现而定
    // 这里只测试已知存在的键，避免不确定行为
    int total = stock["苹果"] + stock["香蕉"]
    println("total={total}")

    return 0
}
