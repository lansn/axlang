// Comparable/Hashable：Self 签名、多 implement、接口变量派发、uint64 强转（GAP #10 前置：文稿 7.1）
class Money implement Comparable, Hashable {
    public int Cents
    constructor(int cents) { this.Cents = cents }
    public override int Compare(Self other) {
        if this.Cents < other.Cents { return -1 }
        if this.Cents > other.Cents { return 1 }
        return 0
    }
    public override uint Hash() {
        uint c = uint(this.Cents)
        uint k = uint(31)
        uint s = uint(7)
        return c * k + s
    }
}

int main() {
    Money a = new Money(100)
    Money b = new Money(250)
    Comparable ca = a
    Comparable cb = b
    println("compare={ca.compare(cb)}")
    println("compare={cb.compare(ca)}")
    Comparable cc = a
    println("compare={ca.compare(cc)}")
    Hashable ha = b
    println("hash={ha.Hash()}")
    return 0
}
