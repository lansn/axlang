// 并发：thread + queue 生产者/消费者
void producer(queue<int> q) {
    for i in 0..5 {
        q.push(i)
    }
    q.close()
}

int main() {
    queue<int> q = queue<int>()
    var t = thread(producer, q)
    for i in 0..100 {
        int? v = q.pop()
        if v == null {
            break
        }
        println("{v}")
    }
    t.join()
    println("done")
    return 0
}
