// strconv 模块：CanBackquote / Quote / Unquote（对标 Go strconv）
import strconv

int main() {
    // CanBackquote：能否作为单行反引号字符串
    println("cb-hello={strconv.canBackquote("hello")}")
    println("cb-tab={strconv.canBackquote("hello\tworld")}")
    println("cb-newline={strconv.canBackquote("hello\nworld")}")
    println("cb-empty={strconv.canBackquote("")}")

    // Quote：双引号括起来的 Go 字符串字面量
    println("q-hello={strconv.quote("hello")}")
    println("q-dquote={strconv.quote("he\"llo")}")
    println("q-backslash={strconv.quote("he\\llo")}")
    println("q-newline={strconv.quote("he\nllo")}")
    println("q-empty={strconv.quote("")}")

    // Unquote：解释双引号字符串字面量
    println("uq-simple={strconv.unquote("\"hello\"")}")
    println("uq-dquote={strconv.unquote("\"he\\\"llo\"")}")
    println("uq-backslash={strconv.unquote("\"he\\\\llo\"")}")
    println("uq-newline={strconv.unquote("\"he\nllo\"")}")
    println("uq-empty={strconv.unquote("\"\"")}")
    println("uq-bad={strconv.unquote("hello")}")

    return 0
}
