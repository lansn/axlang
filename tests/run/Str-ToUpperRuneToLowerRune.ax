// string.ToUpperRune / ToLowerRune（P0，对标 C toupper/tolower / Go unicode.ToUpper/ToLower）
// 仅处理 ASCII 范围：a-z<->A-Z，非 ASCII 码点原样返回；axlang int 映射为 C int64_t。

import string

int main() {
    // ---------- ToUpperRune ----------
    int u1 = 97   // 'a'
    int u2 = 65   // 'A'
    int u3 = 122  // 'z'
    int u4 = 90   // 'Z'
    int u5 = 48   // '0'（数字，不变）
    int u6 = 19988 // '中'（非 ASCII，不变）

    println("toupper_a={string.to_upper_rune(u1)}")   // 65 ('A')
    println("toupper_A={string.to_upper_rune(u2)}")   // 65 ('A'，已大写不变)
    println("toupper_z={string.to_upper_rune(u3)}")   // 90 ('Z')
    println("toupper_Z={string.to_upper_rune(u4)}")   // 90 ('Z'，已大写不变)
    println("toupper_digit={string.to_upper_rune(u5)}")  // 48 ('0'，不变)
    println("toupper_cjk={string.to_upper_rune(u6)}")  // 19988 ('中'，不变)

    // ---------- ToLowerRune ----------
    int l1 = 65   // 'A'
    int l2 = 97   // 'a'
    int l3 = 90   // 'Z'
    int l4 = 122  // 'z'
    int l5 = 48   // '0'（数字，不变）
    int l6 = 19988 // '中'（非 ASCII，不变）

    println("tolower_A={string.to_lower_rune(l1)}")   // 97 ('a')
    println("tolower_a={string.to_lower_rune(l2)}")   // 97 ('a'，已小写不变)
    println("tolower_Z={string.to_lower_rune(l3)}")   // 122 ('z')
    println("tolower_z={string.to_lower_rune(l4)}")   // 122 ('z'，已小写不变)
    println("tolower_digit={string.to_lower_rune(l5)}")  // 48 ('0'，不变)
    println("tolower_cjk={string.to_lower_rune(l6)}")  // 19988 ('中'，不变)

    return 0
}
