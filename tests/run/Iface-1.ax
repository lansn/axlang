// interface 多态（GAP #13 回归）：interface 变量、参数、返回值、数组。
// 表示层是胖指针 { obj, vt }，vt 指向 (类, interface) 专属 shim 虚表；
// 方法调用经 tv.vt 动态派发。

interface Shape {
    int area()
    string name()
}

class Circle implement Shape {
    public int r

    constructor(int r) {
        this.r = r
    }

    public int area() {
        return 3 * this.r * this.r        // 圆周率取 3，输出可预测
    }

    public string name() {
        return "圆"
    }
}

class Square implement Shape {
    public int side

    constructor(int side) {
        this.side = side
    }

    public int area() {
        return this.side * this.side
    }

    public string name() {
        return "方"
    }
}

string tag(Shape s) {
    return s.name() + "面积" + s.area().ToString()   // 上转传参 + 经 interface 派发
}

Shape pick(int which) {
    if which == 1 {
        return new Circle(2)              // 上转：return 处
    }
    return new Square(3)
}

int main() {
    Shape s = new Circle(2)               // 上转：声明处
    Println(tag(s))
    s = new Square(3)                     // 同 interface 再赋另一实现
    Println(tag(s))

    Println(tag(new Circle(4)))           // 直接把子类实例传给 interface 参数
    Shape t = pick(1)
    Println(tag(t))

    Shape[] shapes = [new Circle(1), new Square(2)]   // interface 数组
    for x in shapes {
        Println(tag(x))
    }
    return 0
}
