// ============================================================================
// axlang 多核加速比验证测试 —— Conc-Speedup-2
// 验证：单线程 vs 8 线程求和（各处理 500 万元素数组，共 4000 万元素）
// 注意：输出为确定性计算结果，适合回归比对
// ============================================================================

const int PART = 5000000

// 线程工作函数：创建本地数组 [0..PART]，求和，Push 到队列
void sum_part(queue<int> q) {
    int[] xs = [0]
    for i in 1..PART {
        xs.Push(i)
    }
    int s = 0
    for i in 0..xs.Len() {
        s = s + xs[i]
    }
    q.Push(s)
    q.Close()
}

int main() {
    // ---------- 单线程基准：顺序求和 8 个 500 万元素数组 ----------
    int sum_single = 0
    for j in 0..8 {
        int[] xs = [0]
        for i in 1..PART {
            xs.Push(i)
        }
        for i in 0..xs.Len() {
            sum_single = sum_single + xs[i]
        }
    }

    // ---------- 8 线程并行求和 ----------
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()
    queue<int> q4 = queue<int>()
    queue<int> q5 = queue<int>()
    queue<int> q6 = queue<int>()
    queue<int> q7 = queue<int>()
    queue<int> q8 = queue<int>()

    var t1 = thread(sum_part, q1)
    var t2 = thread(sum_part, q2)
    var t3 = thread(sum_part, q3)
    var t4 = thread(sum_part, q4)
    var t5 = thread(sum_part, q5)
    var t6 = thread(sum_part, q6)
    var t7 = thread(sum_part, q7)
    var t8 = thread(sum_part, q8)

    int sum_multi = 0

    int? v = null

    v = q1.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q2.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q3.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q4.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q5.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q6.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q7.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }
    v = q8.Pop()
    if v != null {
        sum_multi = sum_multi + v
    }

    t1.Join()
    t2.Join()
    t3.Join()
    t4.Join()
    t5.Join()
    t6.Join()
    t7.Join()
    t8.Join()

    // 期望：8 * sum(0..4,999,999) = 8 * 12,499,997,500,000 = 99,999,980,000,000
    int expected = 99999980000000

    println("sum_single={sum_single}")
    println("sum_multi ={sum_multi}")
    println("expected  ={expected}")
    bool ok_single = (sum_single == expected)
    bool ok_multi  = (sum_multi == expected)
    bool ok_equal  = (sum_single == sum_multi)
    println("ok_single={ok_single}")
    println("ok_multi ={ok_multi}")
    println("ok_equal ={ok_equal}")
    println("Conc-Speedup-2 done")
    return 0
}
