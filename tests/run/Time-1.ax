// time 内建具名类型：Now/FromUnixMs 构造，UnixMs/ToString/Format 实例方法，time 间比较。
import std.time

int main() {
    time t0 = std.time.fromUnixMs(0)
    time t1 = std.time.fromUnixMs(1000)
    time t2 = std.time.fromUnixMs(500)
    println(t0.unixMs())
    println(t1.unixMs())
    println(t2.unixMs())
    println(t0 < t1)
    println(t1 > t0)
    println(t0 <= t1)
    println(t1 >= t0)
    time t3 = std.time.fromUnixMs(1000)
    println(t1 < t3)
    println(t1 <= t3)
    println(t1 >= t3)
    println(t1 > t3)
    println(t0.toString())
    println(t1.format("%Y-%m-%d"))
    println(std.time.fromUnixMs(1700000000000).format("%Y-%m-%d %H:%M:%S"))
    return 0
}
