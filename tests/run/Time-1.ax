// time 内建具名类型：Now/FromUnixMs 构造，UnixMs/ToString/Format 实例方法，time 间比较。
import std.time

int main() {
    time t0 = std.time.from_unix_ms(0)
    time t1 = std.time.from_unix_ms(1000)
    time t2 = std.time.from_unix_ms(500)
    println(t0.UnixMs())
    println(t1.UnixMs())
    println(t2.UnixMs())
    println(t0 < t1)
    println(t1 > t0)
    println(t0 <= t1)
    println(t1 >= t0)
    time t3 = std.time.from_unix_ms(1000)
    println(t1 < t3)
    println(t1 <= t3)
    println(t1 >= t3)
    println(t1 > t3)
    println(t0.ToString())
    println(t1.Format("%Y-%m-%d"))
    println(std.time.from_unix_ms(1700000000000).Format("%Y-%m-%d %H:%M:%S"))
    return 0
}
