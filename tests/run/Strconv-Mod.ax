// strconv 模块：Atoi / Itoa / ParseFloat / FormatFloat
import strconv

int main() {
    int n = strconv.atoi("123")
    println(n)
    int n2 = strconv.atoi("abc")
    println(n2)

    string s = strconv.itoa(456)
    println(s)

    float f = strconv.parse_float("3.14")
    println("{f}")
    float f2 = strconv.parse_float("xyz")
    println("{f2}")

    string fs = strconv.format_float(789.5)
    println(fs)

    return 0
}
