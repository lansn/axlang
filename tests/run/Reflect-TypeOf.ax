// reflect.type_of：编译期返回值的静态类型名称字符串
import reflect

struct Point {
    int x
    int y
}

int main() {
    int a = 42
    string s = "hello"
    float f = 3.14
    bool b = true
    Point p = Point(1, 2)

    println("int={reflect.typeOf(a)}")
    println("string={reflect.typeOf(s)}")
    println("float={reflect.typeOf(f)}")
    println("bool={reflect.typeOf(b)}")
    println("Point={reflect.typeOf(p)}")

    return 0
}
