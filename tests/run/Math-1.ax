// math 模块函数一律小写：math.Compare / math.Equals（签名不变）
import math

int main() {
    println("{math.compare(1.0, 2.0)}")
    println("{math.compare(2.0, 2.0)}")
    println("{math.compare(3.0, 2.0)}")
    println("{math.equals(0.1 + 0.2, 0.3, 0.000001)}")
    println("{math.equals(1.0, 2.0, 0.5)}")
    return 0
}
