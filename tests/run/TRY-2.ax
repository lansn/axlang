// TRY-2.ax —— 嵌套 try、catch 内重新抛出、未捕获时交给外层、return 补跑 finally
//
// 语义要点（文稿 10.2）：
//   · catch 里再 throw 不回到本层 catch（否则自己吃自己），而是先执行本层 finally 再向外
//   · return 离开函数前，按内→外补跑各层 finally
//   · 没有 catch 接住的错误，按原路径交给调用方（这里由 main 的 match 收）

result<int> inner(int n) {
    if n < 0 {
        throw error.Invalid("负数")
    }
    if n == 0 {
        throw error.NotFound("零")
    }
    return ok(n * 2)
}

result<int> rewrap(int n) {
    try {
        int v = inner(n)
        return ok(v)
    } catch (error.NotFound e) {
        println("rewrap 接住 NotFound")
        throw error.Money("改写：{e.msg}")
    } finally {
        println("rewrap finally")
    }
}

result<int> early(int n) {
    try {
        if n > 0 {
            println("early 直接返回")
            return ok(n)
        }
        println("early 未返回")
        return ok(0)
    } finally {
        println("early finally")
    }
}

int main() {
    // 1) catch 内再抛 → 本层 finally → 交给调用方的 match
    match rewrap(0) {
        ok(v) => println("不该 ok {v}"),
        fail(e) => println("调用方收到：{e.msg}"),
    }

    // 2) return 与 finally 的顺序
    match early(5) {
        ok(v) => println("early 返回 {v}"),
        fail(e) => println("early 失败 {e.msg}"),
    }

    // 3) 嵌套 try：内层只接 Money，NotFound 落到外层
    try {
        try {
            int a = inner(0)
            println("不可达 {a}")
        } catch (error.Money e) {
            println("内层接 Money")
        } finally {
            println("内层 finally")
        }
    } catch (error e) {
        println("外层接住：{e.msg}")
    } finally {
        println("外层 finally")
    }

    // 4) defer 是块级清理，先于 catch 执行
    try {
        defer println("defer 先跑")
        throw error.IO("磁盘坏了")
    } catch (error.IO e) {
        println("接住 IO：{e.msg}")
    } finally {
        println("finally 后跑")
    }
    return 0
}
