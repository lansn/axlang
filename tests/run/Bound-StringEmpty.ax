// 字符串边界测试：空字符串、单字符
int main() {
    string empty = ""
    string single = "a"
    string normal = "hello"

    println("empty len={empty.len()}")
    println("single len={single.len()}")
    println("normal len={normal.len()}")

    println("empty==\"\"={empty == ""}")
    println("single==\"a\"={single == "a"}")
    println("normal!=single={normal != single}")

    return 0
}
