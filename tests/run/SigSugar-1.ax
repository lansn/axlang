// 签名少写类型（方案 1）：连续同类型参数只在最后一个写类型
// 旧写法 int a, int b 保持完全兼容

// 旧写法：每个参数都显式写类型
int add_old(int a, int b) {
    return a + b
}

// 新写法：b 复用 int
int add_new(int a, b) {
    return a + b
}

// 混合写法：int a, b 是 int，string c 是 string
int mix(int a, b, string c) {
    println("{c}: {a}+{b}={a+b}")
    return a + b
}

// 三个连续同类型
int sum3(int a, b, c) {
    return a + b + c
}

// 借用修饰符复用：&const int a, b
int ref_sum(&const int a, b) {
    return a + b
}

int main() {
    int r1 = add_old(1, 2)
    int r2 = add_new(3, 4)
    int r3 = sum3(5, 6, 7)
    int r4 = ref_sum(8, 9)
    mix(r1, r2, "hello")
    println("{r1} {r2} {r3} {r4}")
    return 0
}
