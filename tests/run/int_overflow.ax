// tests/run/int_overflow.ax —— 整数溢出检查
// 验证：int64 加法溢出触发 R_OVERFLOW 运行期 trap（ax_add_i64 中 i64_add_ovf）
import std.io
import std.strconv

int main() {
    io.writeLine("int64_max=")
    int64 a = 9223372036854775807
    io.writeLine(strconv.itoa(a))

    // 溢出：INT64_MAX + 1，ax_add_i64 将触发 R_OVERFLOW trap，程序退出
    io.writeLine("int64_max+1=")
    io.writeLine(strconv.itoa(a + 1))

    return 0
}
