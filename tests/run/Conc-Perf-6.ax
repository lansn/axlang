// ============================================================================
// axlang 多线程并发性能测试 —— Conc-Perf (256独立队列)
// 验证：256个生产者并发 Push（独立队列）+ 汇总消费，超高并发吞吐量
// ============================================================================

void producer(queue<int> q) {
    for i in 0..5000 {
        q.Push(i)
    }
    q.Close()
}

