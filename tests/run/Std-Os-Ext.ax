// 验证 std.os 扩展函数（C 风格函数名：user_cache_dir / getpagesize / getuid / getgid / geteuid / getegid / getgroups / executable）
import std.os

int main() {
    var dir = std.os.user_cache_dir()
    println("user_cache_dir={dir}")
    var ps = std.os.getpagesize()
    println("getpagesize={ps}")
    var uid = std.os.getuid()
    println("getuid={uid}")
    var gid = std.os.getgid()
    println("getgid={gid}")
    var euid = std.os.geteuid()
    println("geteuid={euid}")
    var egid = std.os.getegid()
    println("getegid={egid}")
    var groups = std.os.getgroups()
    println("getgroups={groups}")
    var exe = std.os.executable()
    println("executable={exe}")
    return 0
}
