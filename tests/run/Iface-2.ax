// interface extend（GAP #13 回归补充）：父 interface 的方法经子 interface
// 变量调用；类实现子 interface 即隐式实现父 interface。

interface Animal {
    string Speak()
}

interface Pet extend Animal {
    string Name()
}

class Dog implement Pet {
    constructor() {}

    public string Speak() {
        return "{this.Name()}：汪"
    }

    public string Name() {
        return "旺财"
    }
}

int main() {
    Pet p = new Dog()
    println(p.Speak())        // speak 来自 extends 的父 interface
    println(p.Name())

    Animal a = new Dog()      // 实现 Pet 即隐式实现 Animal（直接上转到父 interface）
    println(a.Speak())
    return 0
}
