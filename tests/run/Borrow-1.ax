// 借用与所有权正例（M7）：多个 &const 共存、顺序借用、重新赋值复活、
// copy 类型借用警告（W1003 只提示不报错）
int sum(&const int[] xs) {
    int t = 0
    for v in xs {
        t += v
    }
    return t
}

int pair(&const int[] xs, &const int[] ys) {
    return xs[0] + ys[1]
}

void bump(&int[] xs) {
    xs[0] = xs[0] + 100
}

class Buf {
    public int n
    constructor(int n) {
        this.n = n
    }
    public void write(string s) {
        this.n = this.n + s.Len()
    }
}

int main() {
    int[] a = [1, 2, 3]
    int s = sum(&a)          // 只读借用，a 仍可用
    bump(&a)                 // 可变借用，语句结束即失效
    int p = pair(&a, &a)     // 多个 &const 共存合法
    // a[0] 被 bump 改成 101；pair = 101 + 3 = 104
    Println("sum={s} pair={p} len={a.Len()}")
    Println("first={a[0]}")

    // O-09：move 后重新赋值可复活
    var b = new Buf(8)
    var c = b                // 所有权移走
    b = new Buf(4)           // 重新赋值复活
    b.write("xy")            // 合法
    Println("b.n={b.n}")

    // W1003：对 copy 类型（string）借用等价传值，只警告不报错
    string msg = "hi"
    int n = echo(&msg)
    Println("n={n} msg={msg}")
    return 0
}

int echo(&const string s) {
    return s.Len()
}
