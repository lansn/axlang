// 错误处理：try/catch/finally 块
result<int> divide(int a, int b) {
    if b == 0 {
        throw error.Invalid("除数不能是 0")
    }
    return ok(a / b)
}

int main() {
    try {
        int x = divide(10, 0)
        println("不会走到这里 {x}")
    } catch (error.Invalid e) {
        println("除数问题：{e.msg}")
    } catch (error e) {
        println("兜底：{e.msg}")
    } finally {
        println("收尾 1")
    }

    try {
        int y = divide(9, 3)
        println("成功 {y}")
    } catch (error e) {
        println("不该到这里")
    } finally {
        println("收尾 2")
    }

    println("try 之后照常往下走")
    return 0
}
