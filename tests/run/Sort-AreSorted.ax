// sort 模块：IntsAreSorted / StringsAreSorted（对标 Go sort.IntsAreSorted / sort.StringsAreSorted）
import sort

int main() {
    int[] a = [1, 2, 3, 4, 5]
    println("sorted-int={sort.intsAreSorted(a)}")

    int[] b = [1, 3, 2, 4, 5]
    println("unsorted-int={sort.intsAreSorted(b)}")

    int[] c = []
    println("empty-int={sort.intsAreSorted(c)}")

    int[] d = [42]
    println("single-int={sort.intsAreSorted(d)}")

    string[] e = ["apple", "banana", "cherry"]
    println("sorted-str={sort.stringsAreSorted(e)}")

    string[] f = ["banana", "apple", "cherry"]
    println("unsorted-str={sort.stringsAreSorted(f)}")

    return 0
}
