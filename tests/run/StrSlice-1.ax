// string 截取方法 Left/Right/Mid（文稿 11.2，C# 风格，按码点）
// Left(n)：从开头取 n 个字符；Right(n)：从末尾取 n 个字符；
// Mid(start, n)：从索引 start 开始取 n 个字符；越界安全截断。
int main() {
    string s = "axlang"
    string left = s.Left(3)
    string right = s.Right(4)
    string mid = s.Mid(2, 3)
    string mid2 = s.Mid(0, 2)
    string mid3 = s.Mid(4, 10)   // 越界，截断到末尾
    string left0 = s.Left(0)     // 空串
    string right0 = s.Right(0)   // 空串
    string big = s.Left(100)     // 越界，返回整串
    println(s)
    println(left)
    println(right)
    println(mid)
    println(mid2)
    println(mid3)
    println(left0)
    println(right0)
    println(big)
    return 0
}
