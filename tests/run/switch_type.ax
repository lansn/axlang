import std.io
import std.strconv

int main() {
    // object 判断表达式：运行时携带类型 tag
    object o = "hello"
    switch (o) {
        case string s: {
            io.writeLine("string")
            io.writeLine(s)
        }
        case int x: {
            io.writeLine("int")
            io.writeLine(strconv.itoa(x))
        }
        default: {
            io.writeLine("other")
        }
    }

    object n = 42
    switch (n) {
        case int x: {
            io.writeLine("int42")
            io.writeLine(strconv.itoa(x))
        }
        case string s: {
            io.writeLine("string")
            io.writeLine(s)
        }
        default: {
            io.writeLine("other")
        }
    }

    object f = true
    switch (f) {
        case bool: {
            io.writeLine("bool")
        }
        default: {
            io.writeLine("other")
        }
    }

    // 无绑定变量的类型 case：只做类型判断
    object q = "world"
    switch (q) {
        case string: {
            io.writeLine("is string")
        }
        default: {
            io.writeLine("other")
        }
    }

    io.writeLine("done")
    return 0
}
