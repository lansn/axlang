// is(T : Interface)：编译期接口实现检查
interface Shape {
    int area()
}

class Circle implement Shape {
    public int r
    constructor(int r) {
        this.r = r
    }
    public int area() {
        return this.r * this.r
    }
}

class Box {
    public int w
    constructor(int w) {
        this.w = w
    }
}

int main() {
    const bool _c1 = is(Circle : Shape)
    const bool _c2 = is(Box : Shape) == false
    bool b1 = is(Circle : Shape)
    bool b2 = is(Box : Shape)
    println("b1={b1} b2={b2}")
    return 0
}
