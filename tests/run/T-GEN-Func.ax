// 泛型：泛型函数与接口约束
T max<T: Comparable>(T a, T b) {
    return if a > b { a } else { b }
}

string pair<T: Printable>(T x, T y) {
    string s = "{x}"
    s = s + "|" + "{y}"
    return s
}

int main() {
    println("max(1,2)={max(1, 2)}")
    println("max(100,42)={max(100, 42)}")
    println("max<string>={max<string>("apple", "banana")}")
    println("pair={pair("头", "尾")}")
    return 0
}
