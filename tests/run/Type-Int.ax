// int 数据类型正例：加减乘除、取模、移位、按位运算、比较
int add(int a, int b) {
    return a + b
}

int sub(int a, int b) {
    return a - b
}

int mul(int a, int b) {
    return a * b
}

int div(int a, int b) {
    return a / b
}

int mod(int a, int b) {
    return a % b
}

int shl(int a, int n) {
    return a << n
}

int shr(int a, int n) {
    return a >> n
}

int band(int a, int b) {
    return a & b
}

int bor(int a, int b) {
    return a | b
}

int bxor(int a, int b) {
    return a ^ b
}

int bnot(int a) {
    return ~a
}

int neg(int a) {
    return -a
}

int main() {
    int a = 10
    int b = 3
    println("add={add(a, b)}")
    println("sub={sub(a, b)}")
    println("mul={mul(a, b)}")
    println("div={div(a, b)}")
    println("mod={mod(a, b)}")
    println("shl={shl(a, 1)}")
    println("shr={shr(a, 1)}")
    println("band={band(a, b)}")
    println("bor={bor(a, b)}")
    println("bxor={bxor(a, b)}")
    println("bnot={bnot(a)}")
    println("neg={neg(a)}")
    println("eq={a == b}")
    println("ne={a != b}")
    println("lt={a < b}")
    println("gt={a > b}")
    println("le={a <= b}")
    println("ge={a >= b}")
    return 0
}
