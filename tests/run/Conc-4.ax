// 并发原语正例：生产者 Push + Close，主线程 Join 等待完成后消费所有值。
// 验证 thread.Join 确保生产者执行完毕，以及 Pop 计数确定。
void producer(queue<int> q) {
    for i in 0..5 {
        q.Push(i)
    }
    q.Close()
}

int main() {
    queue<int> q = queue<int>()
    var t = thread(producer, q)
    t.Join()
    int count = 0
    for _i in 0..20 {
        int? v = q.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    println("{count}")
    println("done")
    return 0
}
