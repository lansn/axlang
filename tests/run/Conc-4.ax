// 并发原语正例：两个生产者线程并发 Push 到同一阻塞队列。
// 验证多线程并发 Push 及 Join 等待全部生产者完成。
void producer_push(queue<int> q) {
    for i in 0..5 {
        q.Push(i)
    }
}

void producer_push_close(queue<int> q) {
    for i in 0..5 {
        q.Push(i)
    }
    q.Close()
}

int main() {
    queue<int> q = queue<int>()
    var t0 = thread(producer_push, q)
    var t1 = thread(producer_push_close, q)
    t0.Join()
    t1.Join()
    int count = 0
    for i in 0..20 {
        int? v = q.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    println("{count}")
    println("done")
    return 0
}
