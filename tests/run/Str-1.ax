// ASCII / 码点处理（文稿 11.2）：语言里没有 char，一个字符是长度 1 的 string；
// 字符 ↔ 码点走 CodepointAt（string?，越界 null）与 string.FromCodepoint（result<string>）
int main() {
    string s = "AB中文"
    println(s.CodepointAt(0))
    println(s.CodepointAt(1))
    println(s.CodepointAt(2))
    println(s.CodepointAt(99))
    println(string.FromCodepoint(65) try)
    println(string.FromCodepoint(0x4E2D) try)
    string out = ""
    for c in s {
        out += c
    }
    println(out)
    return 0
}
