// Map.Remove / Map.Keys 测试
import json

int main() {
    map<string, int> stock = {}
    stock["柴犬粮"] = 10
    stock["猫粮"] = 5
    stock["鸟粮"] = 20

    // 删除 "猫粮"
    stock.remove("猫粮")
    println("移除后猫粮存在={stock.has("猫粮")}")      // false
    println("移除后柴犬粮存在={stock.has("柴犬粮")}")    // true
    println("移除后长度={stock.len()}")                 // 2

    // Keys：获取所有键
    string[] keys = stock.keys()
    println("键数量={keys.len()}")                      // 2
    // 键顺序为插入顺序：柴犬粮, 鸟粮
    println("第一个键={keys[0]}")                        // 柴犬粮
    println("第二个键={keys[1]}")                        // 鸟粮

    // 再删除一个
    stock.remove("柴犬粮")
    println("再移除后长度={stock.len()}")               // 1
    string[] keys2 = stock.keys()
    println("再移除后键={keys2[0]}")                     // 鸟粮

    return 0
}
