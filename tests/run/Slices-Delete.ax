// slices.delete：删除索引 [i, j) 范围内的元素（数组实例方法）
int main() {
    int[] a = [10, 20, 30, 40, 50, 60]
    a.delete(1, 4)
    println("{a[0]} {a[1]} {a[2]}")

    string[] b = ["a", "b", "c", "d", "e"]
    b.delete(0, 2)
    println("{b[0]} {b[1]} {b[2]}")

    int[] c = [1, 2, 3]
    c.delete(0, 3)
    println("empty-ok={c.Len()}")

    int[] d = [1, 2, 3]
    d.delete(1, 1)
    println("no-op={d[0]} {d[1]} {d[2]}")

    return 0
}
