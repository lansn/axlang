// axlang 多线程并发性能测试 —— Conc-Perf-4 (64独立队列)
// 验证：64个生产者并发 Push（独立队列）+ 汇总消费，极高并发吞吐量
// ============================================================================

void producer(queue<int> q) {
    for i in 0..10000 {
        q.Push(i)
    }
    q.Close()
}

