// filepath 模块：Split（对标 Go filepath.Split，返回 [dir, base]）
import filepath

int main() {
    string[] p = filepath.split(filepath.join(["foo", "bar", "baz.txt"]))
    println("split-dir={p[0]}")
    println("split-base={p[1]}")

    string[] p2 = filepath.split("foo.txt")
    println("split2-dir={p2[0]}")
    println("split2-base={p2[1]}")

    string[] p3 = filepath.split(filepath.join(["a", "b"]))
    println("split3-dir={p3[0]}")
    println("split3-base={p3[1]}")

    return 0
}
