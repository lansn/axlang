// match 多值模式正例：逗号分隔多个值共享一个分支，分支末尾加逗号
string grade(int score) {
    return match score {
        1, 3, 6 => "差",
        2, 4 => "一般",
        5 => "良",
        _ => "未知",
    }
}

string fruit(string name) {
    return match name {
        "apple", "pear" => "水果",
        "carrot" => "蔬菜",
        _ => "其他",
    }
}

int num_group(int n) {
    return match n {
        1, 3, 5, 7, 9 => 1,
        2, 4, 6, 8, 10 => 2,
        _ => 0,
    }
}

int main() {
    println("grade(1)={grade(1)}")
    println("grade(3)={grade(3)}")
    println("grade(6)={grade(6)}")
    println("grade(2)={grade(2)}")
    println("grade(5)={grade(5)}")
    println("grade(9)={grade(9)}")
    println("fruit(apple)={fruit("apple")}")
    println("fruit(carrot)={fruit("carrot")}")
    println("fruit(stone)={fruit("stone")}")
    println("num_group(1)={num_group(1)}")
    println("num_group(2)={num_group(2)}")
    println("num_group(3)={num_group(3)}")
    println("num_group(4)={num_group(4)}")
    println("num_group(5)={num_group(5)}")
    println("num_group(99)={num_group(99)}")
    return 0
}
