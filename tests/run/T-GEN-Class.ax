// 泛型：泛型类与泛型 struct
class Box<T> {
    public T value
    constructor(T v) { this.value = v }
    public T get() {
        return this.value
    }
}

struct Pair<T> {
    T first
    T second
}

int main() {
    Box<int> b = new Box(42)
    println("box={b.get()}")
    Box<string> sb = new Box("文本")
    println("sbox={sb.get()}")
    Pair<int> p = Pair(1, 2)
    println("pair={p.first}+{p.second}={p.first + p.second}")
    return 0
}
