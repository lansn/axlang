// 子串查找方法：IndexOf / LastIndexOf（按 UTF-8 码点索引，未找到返回 -1）
int main() {
    // 基础查找
    println("hello world".IndexOf("world"))   // 6
    println("hello".IndexOf("xyz"))           // -1
    println("hello".IndexOf(""))              // 0
    println("banana".IndexOf("an"))           // 1（首次出现）

    // 反向查找
    println("hello world".LastIndexOf("o"))   // 7
    println("hello".LastIndexOf("xyz"))       // -1
    println("hello".LastIndexOf(""))          // 5（长度）
    println("banana".LastIndexOf("an"))       // 3（最后一次出现）

    // 多字节（中文）按码点索引
    println("你好世界".IndexOf("世"))         // 2
    println("你好世界".LastIndexOf("好"))     // 1
    println("你好世界".IndexOf("世界"))       // 2
    println("你好世界".LastIndexOf("界"))     // 3

    return 0
}
