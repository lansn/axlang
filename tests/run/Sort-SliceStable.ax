// sort.slice_stable：稳定排序（模块级函数）
import sort

int lessInt(int a, int b) {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

int main() {
    int[] xs = [5, 3, 9, 1, 7, 3, 5]
    sort.sliceStable(xs, lessInt)
    println("{xs[0]} {xs[1]} {xs[2]} {xs[3]} {xs[4]} {xs[5]} {xs[6]}")

    return 0
}
