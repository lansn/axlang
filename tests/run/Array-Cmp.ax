// 数组比较实验
int main() {
    int[] a = [1, 2, 3]
    int[] b = [1, 2, 3]
    int[] c = [1, 2, 4]
    int[] d = [1, 2, 3, 4]
    int[] e = []
    int[] f = []
    if a == b {
        println("a==b")
    } else {
        println("a!=b")
    }
    if a == c {
        println("a==c")
    } else {
        println("a!=c")
    }
    if a == d {
        println("a==d")
    } else {
        println("a!=d")
    }
    if e == f {
        println("e==f (both empty)")
    } else {
        println("e!=f")
    }
    if a != c {
        println("a!=c confirmed")
    }
    return 0
}
