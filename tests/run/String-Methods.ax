// string 实例方法回归：锁定 sema intrinsic 表与 codegen 分支的一一对应
// 覆盖：Len/ByteLen/At/Chars/CodepointAt/Contains/Split/IndexOf/LastIndexOf/ToString/
// Trim/Left/Right/Mid/Upper/Lower/StartsWith/EndsWith/Join/Replace/Repeat

int main() {
    string s = "Hello World";
    string c = "ax一中";

    println("trim=[{s.Trim()}]");
    println("upper=[{s.Upper()}]");
    println("lower=[{s.Lower()}]");
    println("contains World={s.contains("World")}");
    println("starts He={s.StartsWith("He")}");
    println("ends d={s.EndsWith("d")}");
    println("left 5=[{s.Left(5)}]");
    println("right 5=[{s.Right(5)}]");
    println("mid 2,4=[{s.Mid(2, 4)}]");
    println("indexOf o={s.IndexOf("o")}");
    println("lastIndexOf l={s.LastIndexOf("l")}");
    println("replace l->L=[{s.Replace("l", "L")}]");
    println("repeat 3=[{s.Repeat(3)}]");
    println("join=[{"-".join(["a", "b"])}]");
    println("split Len={s.Split(",").len()}");
    println("chars Len={s.Chars().len()}");
    println("at 0=[{s.at(0) ?? ""}]");
    println("codepointAt 0={s.CodepointAt(0) ?? -1}");
    println("bytelength={s.ByteLen()}");
    println("length={s.len()}");
    println("c len={c.len()}");
    println("c at 2=[{c.at(2) ?? ""}]");
    println("c codepointAt 2={c.CodepointAt(2) ?? -1}");

    return 0
}
