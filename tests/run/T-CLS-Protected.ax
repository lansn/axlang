// 类：protected 可见性
class Base {
    protected int secret
    constructor(int s) {
        this.secret = s
    }
}

class Child extend Base {
    constructor(int s) {
        parent(s)
    }
    public int reveal() {
        return this.secret
    }
}

int main() {
    Child c = new Child(42)
    println("secret={c.reveal()}")
    return 0
}
