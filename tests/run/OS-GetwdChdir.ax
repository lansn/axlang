// os 模块新增函数：Getwd / Chdir（对标 Go os.Getwd / os.Chdir）
import os

int main() {
    string d1 = os.getwd()
    println("getwd-nonempty={d1.len() > 0}")
    int r1 = os.chdir(d1)
    println("chdir-self={r1}")
    int r2 = os.chdir("__ax_nonexistent_dir__")
    println("chdir-bad={r2}")
    return 0
}
