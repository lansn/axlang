// reflect.num_field：返回结构体字段数量
import reflect

struct Point {
    int x
    int y
}

struct Box {
    Point tl
    Point br
}

int main() {
    Point p = Point(1, 2)
    Box box = Box(Point(0, 0), Point(10, 20))

    println("Point.fields={reflect.numField(p)}")
    println("Box.fields={reflect.numField(box)}")

    return 0
}
