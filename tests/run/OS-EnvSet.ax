// os 模块新增函数：Setenv / Unsetenv（对标 Go os.Setenv/os.Unsetenv）
import os

int main() {
    string name = "AX_ENVTEST";
    string v1 = "abc";
    string v2 = "xyz";
    string empty = "";
    // 先删除不存在的变量，应返回 0（无操作成功）
    println("unset_missing={os.Unsetenv(name)}");
    // 设置环境变量，应返回 0
    println("set={os.Setenv(name, v1)}");
    println("get={os.Getenv(name)}");
    // 覆盖设置
    println("set2={os.Setenv(name, v2)}");
    println("get2={os.Getenv(name)}");
    // 删除环境变量
    println("unset={os.Unsetenv(name)}");
    println("get_after_unset={os.Getenv(name)}");
    // 设置空值
    println("set_empty={os.Setenv(name, empty)}");
    println("get_empty={os.Getenv(name)}");
    return 0
}
