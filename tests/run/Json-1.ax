// json.Parse / json.Stringify / time.NowMs：内建模块从桩补为可用实现
// 覆盖：object/array/string/int/float/bool 解析、各类型解箱、null 键缺席、
//       语法错误 fail 分支、stringify 往返（嵌套 + 转义）、now_ms 单调可用
import json
import time

int show_ok(map<string, object> m) {
    string name = m.Get("name") ?? "?"
    int age = m.Get("age") ?? 0
    float score = m.Get("score") ?? 0.0
    bool vip = m.Get("vip") ?? false
    object? nick = m.Get("nick")
    println("name={name} age={age} score={score} vip={vip}")
    println("nick-null={nick == null}")
    println("keys={m.Len()}")
    return 0
}

int main() {
    string s = "{\"name\":\"tom\",\"age\":18,\"score\":91.5,\"vip\":true,\"nick\":null}"
    result<map<string, object>> r = json.parse(s)
    match r {
        ok(m) => show_ok(m),
        fail(e) => println("fail: {e.msg}"),
    }

    // 语法错误：fail 分支 + 有意义的错误信息（不是空串）
    string bad = "{\"name\":}"
    result<map<string, object>> b = json.parse(bad)
    match b {
        ok(m) => println("bad-ok {m.Len()}"),
        fail(e) => println("parse-error={e.msg.Len() > 0}"),
    }

    // stringify 往返：嵌套对象 / 数组 / 转义
    string s2 = "{\"a\":1,\"b\":[1,2.5,true,\"x\"],\"c\":{\"d\":\"y\"},\"e\":\"he\\\"llo\\n\"}"
    result<map<string, object>> r2 = json.parse(s2)
    match r2 {
        ok(m) => println(json.stringify(m)),
        fail(e) => println("fail: {e.msg}"),
    }

    int t1 = time.now_ms()
    println("time-ok={t1 > 0}")
    return 0
}
