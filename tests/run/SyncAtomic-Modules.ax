// sync/atomic 模块测试（对标 Go sync / sync/atomic，P2，2026-11-24）
// Mutex/RWMutex/WaitGroup/Once 为内建句柄类型，零初始化后直接使用；
// atomic.* 对 int 变量取地址做原子操作，无需构造对象。
import sync
import atomic

int main() {
    // --- sync.Mutex ---
    var m = Mutex()
    m.lock()
    m.unlock()

    // --- atomic.AddInt / LoadInt / StoreInt / CompareAndSwapInt ---
    var v = 0
    atomic.addInt(v, 5)
    println("atomic-1={v}")   // 5
    atomic.storeInt(v, 10)
    println("atomic-2={v}")   // 10
    var loaded = atomic.loadInt(v)
    println("atomic-3={loaded}")  // 10
    var swapped = atomic.compareAndSwapInt(v, 10, 99)
    string swapped_str = ""
    if swapped { swapped_str = "true" } else { swapped_str = "false" }
    println("atomic-4={swapped_str}") // true
    println("atomic-5={v}")       // 99
    var swapped2 = atomic.compareAndSwapInt(v, 10, 77)
    string swapped2_str = ""
    if swapped2 { swapped2_str = "true" } else { swapped2_str = "false" }
    println("atomic-6={swapped2_str}") // false
    println("atomic-7={v}")       // 99

    // --- sync.RWMutex ---
    var rw = RWMutex()
    rw.lock()
    rw.unlock()
    rw.rLock()
    rw.runlock()

    // --- sync.WaitGroup ---
    var wg = WaitGroup()
    wg.add(1)
    wg.done()
    wg.wait()

    // --- sync.Once ---
    var o = Once()
    o.do()

    return 0
}
