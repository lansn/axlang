// GX-04/08：泛型类与泛型 struct——实例化、字段/方法、嵌套实例、
// 实例类实现 interface（胖指针派发）、不变型（GX-08 在 GX-neg-3）
class Box<T> {
    public T Value
    constructor(T v) { this.Value = v }
    public T Get() {
        return this.Value
    }
}
class Node<T> {
    public T V
    constructor(T v) { this.V = v }
    public Box<Box<T>> Wrap() {
        return new Box(new Box(this.V))
    }
}
interface Named {
    string Title()
}
class Box2<T> implement Named {
    public T Value
    constructor(T v) { this.Value = v }
    public override string Title() {
        return "Box2"
    }
}
struct Pair<T> {
    T First
    T Second
}
int main() {
    Box<int> b = new Box(42)
    println(b.Value)
    println(b.get())
    Box<string> sb = new Box("文本")
    println(sb.get())
    Node<int> n = new Node(7)
    Box<Box<int>> bb = n.Wrap()
    println(bb.Value.Value)
    Box2<int> b2 = new Box2(1)
    Named nm = b2
    println(nm.Title())
    Pair<int> p = Pair(1, 2)
    println(p.First + p.Second)
    return 0
}
