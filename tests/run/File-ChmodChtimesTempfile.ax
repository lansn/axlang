// file 模块新增函数：Chmod / Chtimes / TempFile（对标 Go os.Chmod / os.Chtimes / os.CreateTemp）
// Chmod：修改文件权限，0=成功 1=失败；Chtimes：修改访问/修改时间，0=成功 1=失败；
// TempFile：创建临时文件，返回 result<File>。
import file

int main() {
    string f = "__ax_chmodchtimes_test.txt"
    string dir = "."
    string prefix = "__ax_temp_"

    // 清理可能残留的测试文件
    file.Remove(f)

    // 写入测试文件
    int w = file.WriteAll(f, "hello world")
    println("write={w}")

    // Chmod：修改权限，0=成功 1=失败（0o644 = 十进制 420）
    int ch = file.Chmod(f, 0o644)
    println("chmod-ok={ch == 0}")

    // Chtimes：修改访问/修改时间，0=成功 1=失败
    int ct = file.Chtimes(f, 1000000, 2000000)
    println("chtimes-ok={ct == 0}")

    // TempFile：创建临时文件，返回 result<File>
    var tf = file.TempFile(dir, prefix) try
    tf.Close()
    println("tempfile-ok=true")

    // 清理测试文件
    file.Remove(f)

    return 0
}
