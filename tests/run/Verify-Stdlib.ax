// 验证标准库 ax 源码重构可行性
// import std.string -> axc/std/string.ax，调用 C 风格函数

import std.string

int main() {
    var r = std.string.compare("abc", "abc")
    println("compare-abc-abc={r}")

    var c = std.string.compare("abc", "abd")
    println("compare-abc-abd={c}")

    var has = std.string.contains("hello world", "world")
    println("contains={has}")

    var idx = std.string.indexOf("hello world", "world")
    println("index_of={idx}")

    var up = std.string.toUpper("hello")
    println("to_upper={up}")

    var low = std.string.toLower("HELLO")
    println("to_lower={low}")

    var trimmed = std.string.trim("  hello  ")
    println("trim={trimmed}")

    var rep = std.string.repeat("ab", 3)
    println("repeat={rep}")

    return 0
}
