// 定长数组切片测试（深度复制）
int main() {
    int[5] xs = [10, 20, 30, 40, 50]

    // 左闭右开切片
    int[] a = xs[1..3]
    println("a len={a.Len()}")       // 2
    println("a={a}")                 // [20, 30]
    println("a[0]={a[0]} a[1]={a[1]}")  // 20 30

    // 左闭右闭切片
    int[] b = xs[0..=2]
    println("b len={b.Len()}")       // 3
    println("b={b}")                 // [10, 20, 30]

    // 整个数组切片
    int[] c = xs[0..5]
    println("c={c}")                 // [10, 20, 30, 40, 50]

    // 空切片
    int[] d = xs[2..2]
    println("d len={d.Len()}")       // 0
    println("d={d}")                 // []

    // 深度复制验证：修改切片不影响原数组
    a[0] = 99
    println("after modify a[0]=99")
    println("xs[1]={xs[1]}")         // 应该还是 20（深度复制，不受影响）
    println("a[0]={a[0]}")           // 99

    // 修改原数组不影响切片
    xs[0] = 100
    println("after modify xs[0]=100")
    println("c[0]={c[0]}")           // 应该还是 10（深度复制，不受影响）

    return 0
}
