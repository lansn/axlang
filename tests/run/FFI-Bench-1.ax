// ============================================================================
// axlang FFI 批量调用基准测试 —— FFI-Bench-1
// 验证：批量调用 C 库函数 abs，验证 FFI 调用开销与吞吐量
// 注意：abs 不产生 stdout 输出，保持测试输出确定性
// ============================================================================

extern "C" {
    int abs(int x);
}

int main() {
    const int N = 100000

    // ---------- 测试：批量 FFI 调用 abs ----------
    int sum = 0
    for i in 0..N {
        int r = 0
        unsafe {
            r = abs(i - N / 2)
        }
        sum = sum + r
    }

    // 期望：sum = sum_{i=0}^{N-1} abs(i - N/2)
    // N=100000, N/2=50000
    // sum_{i=0}^{N-1} abs(i - N/2) = 2500000000
    int expected = 2500000000

    println("sum={sum}")
    println("expected={expected}")
    bool ok = (sum == expected)
    println("ok={ok}")
    println("FFI-Bench-1 done")
    return 0
}
