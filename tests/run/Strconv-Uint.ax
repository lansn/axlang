// strconv 模块新增函数：ParseUint / FormatUint（对标 Go strconv.ParseUint/FormatUint）
// axlang 无 uint 类型，故返回/接收 int（int64），值范围受 int64 限制。
import strconv

int main() {
    // ParseUint：十进制
    println("parse-uint-10={strconv.ParseUint("123", 10)}")
    // ParseUint：十六进制
    println("parse-uint-16={strconv.ParseUint("ff", 16)}")
    // ParseUint：八进制
    println("parse-uint-8={strconv.ParseUint("17", 8)}")
    // ParseUint：二进制
    println("parse-uint-2={strconv.ParseUint("1010", 2)}")
    // ParseUint：base=0 自动判断 0x 前缀
    println("parse-uint-auto-hex={strconv.ParseUint("0xff", 0)}")
    // ParseUint：base=0 自动判断 0 前缀（八进制）
    println("parse-uint-auto-oct={strconv.ParseUint("017", 0)}")
    // ParseUint：无效输入
    println("parse-uint-invalid={strconv.ParseUint("xyz", 10)}")
    // ParseUint：超出 int64 范围（2^64）
    println("parse-uint-overflow={strconv.ParseUint("18446744073709551616", 10)}")

    // FormatUint：十进制
    println("format-uint-10={strconv.FormatUint(255, 10)}")
    // FormatUint：十六进制
    println("format-uint-16={strconv.FormatUint(255, 16)}")
    // FormatUint：八进制
    println("format-uint-8={strconv.FormatUint(255, 8)}")
    // FormatUint：二进制
    println("format-uint-2={strconv.FormatUint(255, 2)}")
    // FormatUint：base=0 按十进制输出
    println("format-uint-auto={strconv.FormatUint(255, 0)}")

    return 0
}
