// file 模块新增函数：IsDir / IsFile（对标 Go os.Stat + FileInfo.IsDir）
import file

int main() {
    string dir = "__ax_isdir_test_dir"
    string f = "__ax_isfile_test.txt"
    string missing = "__ax_no_such_path_xyz"

    // 清理可能残留的测试文件（目录留给 Mkdir 处理）
    file.remove(f)

    // 创建目录并判断类型（Mkdir 若目录已存在会返回 1，不影响 IsDir 判断）
    file.mkdir(dir)
    println("isdir-dir={file.is_dir(dir)}")
    println("isfile-dir={file.is_file(dir)}")

    // 创建文件并判断类型
    int w = file.write_all(f, "hello")
    println("write={w}")
    println("isdir-file={file.is_dir(f)}")
    println("isfile-file={file.is_file(f)}")

    // 不存在的路径
    println("isdir-missing={file.is_dir(missing)}")
    println("isfile-missing={file.is_file(missing)}")

    // 清理测试文件
    file.remove(f)

    return 0
}
