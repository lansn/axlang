// time 实例方法扩展：Equal / Compare / Sub / Add / Round / Truncate（对标 Go time，P0）
// axlang time 为 Unix 毫秒（int64）。
import std.time

int main() {
    time t1 = std.time.unix_milli(1000)
    time t2 = std.time.unix_milli(2000)
    time t3 = std.time.unix_milli(1000)

    println("equal_1_2={t1.Equal(t2)}")
    println("equal_1_3={t1.Equal(t3)}")
    println("compare_1_2={t1.Compare(t2)}")
    println("compare_2_1={t2.Compare(t1)}")
    println("compare_1_3={t1.Compare(t3)}")
    println("sub_2_1={t2.Sub(t1)}")
    println("sub_1_2={t1.Sub(t2)}")
    println("add_1_1000={t1.Add(1000).UnixMs()}")
    println("round_1500_1000={std.time.unix_milli(1500).Round(1000).UnixMs()}")
    println("round_1499_1000={std.time.unix_milli(1499).Round(1000).UnixMs()}")
    println("truncate_1500_1000={std.time.unix_milli(1500).Truncate(1000).UnixMs()}")
    println("truncate_1499_1000={std.time.unix_milli(1499).Truncate(1000).UnixMs()}")
    return 0
}
