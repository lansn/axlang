// ============================================================================
// axlang 多线程并发性能测试 —— Conc-Perf-1 (8独立队列)
// 验证：8个生产者并发 Push（独立队列）+ 汇总消费
// ============================================================================

void producer(queue<int> q) {
    for i in 0..10000 {
        q.Push(i)
    }
    q.Close()
}

int main() {
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()
    queue<int> q4 = queue<int>()
    queue<int> q5 = queue<int>()
    queue<int> q6 = queue<int>()
    queue<int> q7 = queue<int>()
    queue<int> q8 = queue<int>()

    var t1 = thread(producer, q1)
    var t2 = thread(producer, q2)
    var t3 = thread(producer, q3)
    var t4 = thread(producer, q4)
    var t5 = thread(producer, q5)
    var t6 = thread(producer, q6)
    var t7 = thread(producer, q7)
    var t8 = thread(producer, q8)

    int count = 0

    // 主线程并发 Pop（不等待 Join，模拟真实并发场景）
    for i in 0..80000 {
        int? v = q1.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q2.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q3.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q4.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q5.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q6.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q7.Pop()
        if v == null {
            break
        }
        count = count + 1
    }
    for i in 0..80000 {
        int? v = q8.Pop()
        if v == null {
            break
        }
        count = count + 1
    }

    t1.Join()
    t2.Join()
    t3.Join()
    t4.Join()
    t5.Join()
    t6.Join()
    t7.Join()
    t8.Join()

    // 期望 8 * 10000 = 80000
    println("{count}")
    println("done")
    return 0
}
