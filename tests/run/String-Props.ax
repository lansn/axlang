// string 实例方法：IsDigit / IsAlpha / IsSpace / IsLower / IsUpper / IsAlnum（对标 C <ctype.h>）
// 对整个字符串判断：所有字符均满足返回 1，否则返回 0；空字符串返回 0。
import string

int main() {
    // IsDigit：全数字
    string d1 = "123"
    println("digit-123={d1.IsDigit()}")
    string d2 = "12a"
    println("digit-12a={d2.IsDigit()}")
    string d3 = ""
    println("digit-empty={d3.IsDigit()}")
    string d4 = "007"
    println("digit-007={d4.IsDigit()}")

    // IsAlpha：全字母
    string a1 = "abc"
    println("alpha-abc={a1.IsAlpha()}")
    string a2 = "ab1"
    println("alpha-ab1={a2.IsAlpha()}")
    string a3 = ""
    println("alpha-empty={a3.IsAlpha()}")
    string a4 = "ABCxyz"
    println("alpha-ABCxyz={a4.IsAlpha()}")

    // IsSpace：全空白
    string sp1 = "   "
    println("space-spaces={sp1.IsSpace()}")
    string sp2 = "\t\n"
    println("space-tabnl={sp2.IsSpace()}")
    string sp3 = " a "
    println("space-a-space={sp3.IsSpace()}")
    string sp4 = ""
    println("space-empty={sp4.IsSpace()}")

    // IsLower：全小写
    string l1 = "abc"
    println("lower-abc={l1.IsLower()}")
    string l2 = "Abc"
    println("lower-Abc={l2.IsLower()}")
    string l3 = ""
    println("lower-empty={l3.IsLower()}")
    string l4 = "xyz"
    println("lower-xyz={l4.IsLower()}")

    // IsUpper：全大写
    string u1 = "ABC"
    println("upper-ABC={u1.IsUpper()}")
    string u2 = "AbC"
    println("upper-AbC={u2.IsUpper()}")
    string u3 = ""
    println("upper-empty={u3.IsUpper()}")
    string u4 = "XYZ"
    println("upper-XYZ={u4.IsUpper()}")

    // IsAlnum：字母或数字
    string n1 = "abc123"
    println("alnum-abc123={n1.IsAlnum()}")
    string n2 = "abc 123"
    println("alnum-abc-space-123={n2.IsAlnum()}")
    string n3 = ""
    println("alnum-empty={n3.IsAlnum()}")
    string n4 = "ABC123"
    println("alnum-ABC123={n4.IsAlnum()}")
    string n5 = "abc!"
    println("alnum-abc-bang={n5.IsAlnum()}")

    return 0
}
