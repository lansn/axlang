// array 数据类型正例：创建、访问、修改、for-in 遍历、长度
// 注意：数组是 move 语义，传给函数后原变量不可再用，需先打印再传
int sum(int[] xs) {
    int s = 0
    for x in xs {
        s = s + x
    }
    return s
}

int main() {
    // 动态数组
    int[] xs = [1, 2, 3, 4, 5]
    println("len={xs.Len()}")

    // 先访问修改，再传给 sum（避免 move 后使用）
    xs[0] = 100
    println("xs[0]={xs[0]}")
    println("sum={sum(xs)}")

    // 定长数组 T[N]
    int[3] ys = [10, 20, 30]
    println("ys[1]={ys[1]}")

    // 字符串数组
    string[] names = ["旺财", "小黑", "豆豆"]
    for s in names {
        println("名字={s}")
    }

    // 空数组需要目标类型
    int[] empty = []
    println("empty len={empty.Len()}")

    return 0
}
