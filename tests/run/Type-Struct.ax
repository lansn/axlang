// struct 数据类型正例：值语义、字段访问、构造、方法
// 字段名必须是 camelCase（E3043）
struct Point {
    int x
    int y
}

int area(Point p) {
    return p.x * p.y
}

int main() {
    Point p = Point(10, 20)
    println("p.x={p.x}")
    println("p.y={p.y}")
    println("area={area(p)}")

    // struct 字段可直接修改（值语义）
    p.x = 30
    println("p.x={p.x}")
    println("area={area(p)}")

    return 0
}
