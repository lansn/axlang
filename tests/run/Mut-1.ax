int main() {
    int[] xs = [3, 1, 2]
    xs.push(4)
    int n = xs.len()
    println("push 后 {n}")

    int v = xs.pop()
    int m = xs.len()
    println("pop 得 {v}，剩 {m}")

    int[] ys = [9, 8, 7]
    ys.remove(1)
    int k = ys.len()
    println("remove 后 {k}")

    ys.clear()
    int c = ys.len()
    println("clear 后 {c}")
    return 0
}
