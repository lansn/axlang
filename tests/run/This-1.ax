class Calc {
    public int Base
    constructor(int base) {
        this.Base = base
    }
    public int DoubleIt() {
        return this.Base * 2
    }
    public static int Add(int a, int b) {
        return a + b
    }
}
int main() {
    Calc c = new Calc(3)
    int d = c.DoubleIt()
    int s = Calc.add(1, 2)
    println("d = {d}, s = {s}")
    return 0
}
