class Calc {
    public int base
    constructor(int base) {
        this.base = base
    }
    public int double_it() {
        return this.base * 2
    }
    public static int add(int a, int b) {
        return a + b
    }
}
int main() {
    Calc c = new Calc(3)
    int d = c.double_it()
    int s = Calc.add(1, 2)
    Println("d = {d}, s = {s}")
    return 0
}
