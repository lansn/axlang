// ============================================================================
// axlang 多线程并发性能测试 —— Conc-Perf-2 (16独立队列)
// 验证：16个生产者并发 Push（独立队列）+ 汇总消费，高并发吞吐量
// ============================================================================

void producer(queue<int> q) {
    for i in 0..10000 {
        q.push(i)
    }
    q.close()
}

int main() {
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()
    queue<int> q4 = queue<int>()
    queue<int> q5 = queue<int>()
    queue<int> q6 = queue<int>()
    queue<int> q7 = queue<int>()
    queue<int> q8 = queue<int>()
    queue<int> q9 = queue<int>()
    queue<int> q10 = queue<int>()
    queue<int> q11 = queue<int>()
    queue<int> q12 = queue<int>()
    queue<int> q13 = queue<int>()
    queue<int> q14 = queue<int>()
    queue<int> q15 = queue<int>()
    queue<int> q16 = queue<int>()

    var t1 = thread(producer, q1)
    var t2 = thread(producer, q2)
    var t3 = thread(producer, q3)
    var t4 = thread(producer, q4)
    var t5 = thread(producer, q5)
    var t6 = thread(producer, q6)
    var t7 = thread(producer, q7)
    var t8 = thread(producer, q8)
    var t9 = thread(producer, q9)
    var t10 = thread(producer, q10)
    var t11 = thread(producer, q11)
    var t12 = thread(producer, q12)
    var t13 = thread(producer, q13)
    var t14 = thread(producer, q14)
    var t15 = thread(producer, q15)
    var t16 = thread(producer, q16)

    int count = 0

    // 汇总每个队列的值
    int? v = null

    v = q1.pop()
    while v != null {
        count = count + 1
        v = q1.pop()
    }
    v = q2.pop()
    while v != null {
        count = count + 1
        v = q2.pop()
    }
    v = q3.pop()
    while v != null {
        count = count + 1
        v = q3.pop()
    }
    v = q4.pop()
    while v != null {
        count = count + 1
        v = q4.pop()
    }
    v = q5.pop()
    while v != null {
        count = count + 1
        v = q5.pop()
    }
    v = q6.pop()
    while v != null {
        count = count + 1
        v = q6.pop()
    }
    v = q7.pop()
    while v != null {
        count = count + 1
        v = q7.pop()
    }
    v = q8.pop()
    while v != null {
        count = count + 1
        v = q8.pop()
    }
    v = q9.pop()
    while v != null {
        count = count + 1
        v = q9.pop()
    }
    v = q10.pop()
    while v != null {
        count = count + 1
        v = q10.pop()
    }
    v = q11.pop()
    while v != null {
        count = count + 1
        v = q11.pop()
    }
    v = q12.pop()
    while v != null {
        count = count + 1
        v = q12.pop()
    }
    v = q13.pop()
    while v != null {
        count = count + 1
        v = q13.pop()
    }
    v = q14.pop()
    while v != null {
        count = count + 1
        v = q14.pop()
    }
    v = q15.pop()
    while v != null {
        count = count + 1
        v = q15.pop()
    }
    v = q16.pop()
    while v != null {
        count = count + 1
        v = q16.pop()
    }

    t1.join()
    t2.join()
    t3.join()
    t4.join()
    t5.join()
    t6.join()
    t7.join()
    t8.join()
    t9.join()
    t10.join()
    t11.join()
    t12.join()
    t13.join()
    t14.join()
    t15.join()
    t16.join()

    // 期望 16 * 10000 = 160000
    println("{count}")
    println("done")
    return 0
}
