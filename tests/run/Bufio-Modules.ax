// bufio 模块测试（对标 Go bufio，P2，2026-11-24）
// Reader/Writer/Scanner 均基于 File 句柄（ax_file*），无需新增底层类型
import std.bufio
import file

int main() {
    // 测试 std.bufio.new_reader：缓冲读取器，对标 Go bufio.NewReader
    var f = file.create("/tmp/bufio_test.txt") try
    f.writeLine("line1")
    f.writeLine("line2")
    f.writeLine("line3")
    f.close()

    var f2 = file.open("/tmp/bufio_test.txt") try
    var br = std.bufio.newReader(f2)
    var l1 = br.readLine()
    println("reader-1={l1}")   // line1
    var l2 = br.readLine()
    println("reader-2={l2}")   // line2
    br.close()

    // 测试 std.bufio.new_writer：缓冲写入器，对标 Go bufio.NewWriter
    var f3 = file.create("/tmp/bufio_test2.txt") try
    var bw = std.bufio.newWriter(f3)
    bw.writeLine("buffered write")
    bw.close()

    var f4 = file.open("/tmp/bufio_test2.txt") try
    var wl = f4.readLine()
    println("writer-1={wl}")   // buffered write
    f4.close()

    // 测试 std.bufio.scanner：扫描器，对标 Go bufio.NewScanner
    var f5 = file.open("/tmp/bufio_test.txt") try
    var sc = std.bufio.scanner(f5)
    var s1 = sc.readLine()
    println("scanner-1={s1}")  // line1
    sc.close()

    return 0
}
