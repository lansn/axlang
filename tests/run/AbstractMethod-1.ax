abstract class Shape {
    public int id
    constructor(int id) { this.id = id }
    public abstract void draw();
}

class Circle extend Shape {
    public int r
    constructor(int id, int r) { parent(id); this.r = r }
    public override void draw() { println("circle id={this.id} r={this.r}") }
}

int main() {
    var c = Circle(1, 5)
    c.draw()
    return 0
}
