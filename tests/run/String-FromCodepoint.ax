// string.FromCodepoint 测试：码点 → string（result<string>）
import string

int main() {
    // 有效码点
    result<string> r1 = string.FromCodepoint(65)
    match r1 {
        ok(s) => println("65={s}"),
        fail(e) => println("65-fail={e.msg}"),
    }

    result<string> r2 = string.FromCodepoint(97)
    match r2 {
        ok(s) => println("97={s}"),
        fail(e) => println("97-fail={e.msg}"),
    }

    result<string> r3 = string.FromCodepoint(19968)
    match r3 {
        ok(s) => println("19968={s}"),
        fail(e) => println("19968-fail={e.msg}"),
    }

    // 无效码点（UTF-8 无法编码）
    result<string> r4 = string.FromCodepoint(-1)
    match r4 {
        ok(s) => println("-1-ok={s}"),
        fail(e) => println("-1-fail={e.msg}"),
    }

    result<string> r5 = string.FromCodepoint(0x110000)
    match r5 {
        ok(s) => println("0x110000-ok={s}"),
        fail(e) => println("0x110000-fail={e.msg}"),
    }

    return 0
}
