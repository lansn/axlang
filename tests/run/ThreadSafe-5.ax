// ============================================================================
// axlang 多线程通信测试 —— ThreadSafe-5（模式 2：队列异步通知）
// 验证：主线程不 Join，先执行其他工作，再通过 Pop 收到 null 得知
//       工作线程已结束（Close 发送的结束信号）
// ============================================================================

// 工作线程：执行耗时计算，结果通过队列返回，Close 发送结束信号
void worker(queue<int> q) {
    int result = 0
    for i in 0..1000 {
        result = result + i
    }
    q.push(result)
    q.close()
}

int main() {
    queue<int> q = queue<int>()
    var t = thread(worker, q)

    // 模式 2：主线程不阻塞等待，先执行其他工作（模拟 GUI 事件处理）
    int side_work = 0
    for i in 0..100 {
        side_work = side_work + i
    }
    println("side_work={side_work}")

    // 之后阻塞 Pop 等待工作线程结果；收到 null 表示队列已关闭（worker 结束）
    int? v = q.pop()
    if v != null {
        println("result={v}")
    } else {
        println("result=null")
    }

    // 回收线程资源（worker 已结束，Join 会立即返回）
    t.join()

    println("ThreadSafe-5 done")
    return 0
}
