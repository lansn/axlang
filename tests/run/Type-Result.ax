// result<T> 数据类型正例：ok/fail、try 传播、match 处理
result<int> divide(int a, int b) {
    if b == 0 {
        throw error.Invalid("除数不能为 0")
    }
    return ok(a / b)
}

result<string> safe_divide(int a, int b) {
    // try 传播：失败会返回调用方，成功展开为 int
    int q = divide(a, b) try
    return ok("商={q}")
}

int main() {
    // 成功路径
    result<string> r1 = safe_divide(10, 2)
    match r1 {
        ok(s) => println("成功：{s}"),
        fail(e) => println("失败：{e.msg}"),
    }

    // 失败路径
    result<string> r2 = safe_divide(10, 0)
    match r2 {
        ok(s) => println("成功：{s}"),
        fail(e) => println("失败：{e.msg}"),
    }

    return 0
}
