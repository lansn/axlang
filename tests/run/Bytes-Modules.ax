// bytes 模块测试（对标 Go bytes，P2，2026-11-24）
// bytes 类型名在类型位置解析为 byte[]（uint8_t[] 数组）
import bytes

int main() {
    // bytes.Contains
    byte[] s1 = [1, 2, 3, 4, 5]
    byte[] sub1 = [2, 3]
    byte[] sub2 = [6, 7]
    println("contains-1={bytes.contains(s1, sub1)}")  // true
    println("contains-2={bytes.contains(s1, sub2)}")  // false

    // bytes.Equal
    byte[] a1 = [1, 2, 3]
    byte[] a2 = [1, 2, 3]
    byte[] a3 = [1, 2, 4]
    println("equal-1={bytes.equal(a1, a2)}")  // true
    println("equal-2={bytes.equal(a1, a3)}")  // false

    // bytes.Index
    byte[] s2 = [10, 20, 30, 20, 40]
    byte[] sub3 = [20]
    println("index-1={bytes.index(s2, sub3)}")  // 1
    byte[] sub4 = [99]
    println("index-2={bytes.index(s2, sub4)}")  // -1

    // bytes.TrimSpace
    byte[] sp = [32, 32, 65, 66, 32]  // "  AB "
    byte[] tp = bytes.trim_space(sp)
    println("trimspace-len={tp.Len()}")  // 2

    // bytes.ToUpper / ToLower
    byte[] lower = [97, 98, 99]  // "abc"
    byte[] upper = bytes.to_upper(lower)
    println("toupper-len={upper.Len()}")  // 3
    byte[] upper2 = [65, 66, 67]  // "ABC"
    byte[] lower2 = bytes.to_lower(upper2)
    println("tolower-len={lower2.Len()}")  // 3

    // bytes.Repeat
    byte[] rep = [1, 2]
    byte[] rep2 = bytes.repeat(rep, 3)
    println("repeat-len={rep2.Len()}")  // 6

    // bytes.Split
    byte[] spl = [1, 2, 0, 3, 4, 0, 5]
    byte[] sep = [0]
    byte[][] parts = bytes.split(spl, sep)
    println("split-len={parts.Len()}")  // 3

    return 0
}
