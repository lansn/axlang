// bytes 模块测试（对标 Go bytes，P2，2026-11-24）
// bytes 类型名在类型位置解析为 byte[]（uint8_t[] 数组）
import std.bytes

int main() {
    // std.bytes.contains
    byte[] s1 = [1, 2, 3, 4, 5]
    byte[] sub1 = [2, 3]
    byte[] sub2 = [6, 7]
    println("contains-1={std.bytes.contains(s1, sub1)}")  // true
    byte[] s1b = [1, 2, 3, 4, 5]
    println("contains-2={std.bytes.contains(s1b, sub2)}")  // false

    // std.bytes.equal
    byte[] a1 = [1, 2, 3]
    byte[] a2 = [1, 2, 3]
    byte[] a3 = [1, 2, 4]
    println("equal-1={std.bytes.equal(a1, a2)}")  // true
    byte[] a1b = [1, 2, 3]
    println("equal-2={std.bytes.equal(a1b, a3)}")  // false

    // std.bytes.index
    byte[] s2 = [10, 20, 30, 20, 40]
    byte[] sub3 = [20]
    println("index-1={std.bytes.index(s2, sub3)}")  // 1
    byte[] s2b = [10, 20, 30, 20, 40]
    byte[] sub4 = [99]
    println("index-2={std.bytes.index(s2b, sub4)}")  // -1

    // std.bytes.trim_space
    byte[] sp = [32, 32, 65, 66, 32]  // "  AB "
    byte[] tp = std.bytes.trim_space(sp)
    println("trimspace-len={tp.len()}")  // 2

    // std.bytes.to_upper / to_lower
    byte[] lower = [97, 98, 99]  // "abc"
    byte[] upper = std.bytes.to_upper(lower)
    println("toupper-len={upper.len()}")  // 3
    byte[] upper2 = [65, 66, 67]  // "ABC"
    byte[] lower2 = std.bytes.to_lower(upper2)
    println("tolower-len={lower2.len()}")  // 3

    // std.bytes.repeat
    byte[] rep = [1, 2]
    byte[] rep2 = std.bytes.repeat(rep, 3)
    println("repeat-len={rep2.len()}")  // 6

    // std.bytes.split
    byte[] spl = [1, 2, 0, 3, 4, 0, 5]
    byte[] sep = [0]
    byte[][] parts = std.bytes.split(spl, sep)
    println("split-len={parts.len()}")  // 3

    return 0
}
