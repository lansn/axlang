// filepath 模块：Ext（对标 Go filepath.Ext）
import filepath

int main() {
    println("ext1={filepath.ext("foo.txt")}")
    println("ext2={filepath.ext("archive.tar.gz")}")
    println("ext3={filepath.ext("noext")}")
    println("ext4={filepath.ext(".hidden")}")
    println("ext5={filepath.ext("dir/")}")
    println("ext6={filepath.ext("a/b/c.py")}")
    return 0
}
