// abstract 关键词：抽象类不能直接 new，子类可继承并实例化
abstract class Shape {
    public int Id
    constructor(int id) { this.Id = id }
}

class Circle extend Shape {
    public int R
    constructor(int id, int r) { parent(id); this.R = r }
    public void Draw() { println("circle id={this.Id} r={this.R}") }
}

class Rect extend Shape {
    public int W
    public int H
    constructor(int id, int w, int h) { parent(id); this.W = w; this.H = h }
    public void Draw() { println("rect id={this.Id} w={this.W} h={this.H}") }
}

int main() {
    Circle c = new Circle(10, 5)
    Rect r = new Rect(20, 3, 4)
    c.Draw()
    r.Draw()
    return 0
}
