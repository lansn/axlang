// 并发原语正例：queue<string> 生产者/消费者。
// 验证阻塞队列对非 int 元素类型（string）的支持。
void producer(queue<string> q) {
    q.Push("foo")
    q.Push("bar")
    q.Push("baz")
    q.Close()
}

int main() {
    queue<string> q = queue<string>()
    var t = thread(producer, q)
    for _i in 0..100 {
        string? v = q.Pop()
        if v == null {
            break
        }
        println(v)
    }
    t.Join()
    println("done")
    return 0
}
