// 32 位浮点内建：float32 类型与 f32 字面量后缀
// float（64 位）与 float32（32 位）并存

float32 add_f32(float32 a, float32 b) {
    return a + b
}

// float 与 float32 混合：float32 扩大为 float
float mixed(float32 a, float b) {
    return a + b
}

int main() {
    float32 x = 1.5f32
    float32 y = 2.25f32
    float32 r = add_f32(x, y)
    float m = mixed(x, 3.5)
    println("{r} {m}")
    println("{1.5f32 + 2.25f32}")
    return 0
}
