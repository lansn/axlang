// print/println 的实参放宽（文稿 11.2）：非字符串的可插值直接输出，
// 等价于 `print("{x}")`——仍然只有插值一种格式化能力
class User implement Printable {
    public int Id
    public string Name
    constructor(int id, string name) { this.Id = id; this.Name = name }
    public override string ToString() { return "User({this.Id}, {this.Name})" }
}
enum Color { Red, Green, Blue }

int main() {
    println(123)
    println(3.5)
    println(true)
    print("不换行：")
    println(42)
    println(new User(7, "阿蓝"))
    println(Color.Green)
    int n = 9
    println(n)
    println("字符串常量照旧")
    return 0
}
