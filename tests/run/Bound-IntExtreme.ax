// int 边界值测试：极大极小值、溢出行为
int main() {
    int max = 2147483647
    int min = -2147483648
    int zero = 0

    println("max={max}")
    println("min={min}")
    println("zero={zero}")

    // 加法边界
    int sum = max + 0
    println("max+0={sum}")

    // 减法边界
    int diff = min - 0
    println("min-0={diff}")

    // 乘法边界
    int prod = max * 1
    println("max*1={prod}")

    // 除法边界
    int quot = max / 1
    println("max/1={quot}")

    // 取模边界
    int rem = max % 2
    println("max%2={rem}")

    return 0
}
