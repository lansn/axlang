// 类：class 基本声明与实例化
class User {
    public int id
    public string name
    constructor(int id, string name) {
        this.id = id
        this.name = name
    }
    public string describe() {
        return "User({this.id}, {this.name})"
    }
}

int main() {
    User u = new User(1, "axlang")
    println(u.describe())
    return 0
}
