// to_string：int/float/bool/enum 转字符串
enum Color { Red, Green, Blue }

int main() {
    int i = 42
    float f = 3.14
    bool b = true
    Color c = Color.Green
    println("i={i.toString()}")
    println("f={f.toString()}")
    println("b={b.toString()}")
    println("c={c.toString()}")
    return 0
}
