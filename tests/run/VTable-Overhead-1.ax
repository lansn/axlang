// interface vtable 开销分析测试 —— VTable-Overhead-1
// 对比直接方法调用 (obj.Method) vs 接口胖指针 vtable 调用 (ifc.Method)
// 的执行耗时，验证 vtable 动态派发开销是否可接受。
//
// 运行方式：
//   dist/axc.exe build tests/run/VTable-Overhead-1.ax -o vt.exe
//   vt.exe        // 观察 direct_ms / iface_ms，计算 vtable 开销比例
//
// 本 .out 文件仅断言：直接调用与接口调用产生相同计算结果（正确性）。
// 具体耗时因机器而异，不写入 .out，避免回归误报。

interface IFoo {
    int Calc(int x)
}

class Impl implement IFoo {
    constructor() {}
    public override int Calc(int x) {
        int r = 0
        for i in 0..x {
            r = r + i
        }
        return r
    }
}

int main() {
    const int N = 10000000
    Impl obj = new Impl()
    IFoo ifc = obj

    // ---------- 直接调用 ----------
    int r1 = 0
    for i in 0..N {
        r1 = r1 + obj.Calc(100)
    }

    // ---------- 接口 vtable 调用 ----------
    int r2 = 0
    for i in 0..N {
        r2 = r2 + ifc.Calc(100)
    }

    println("r1={r1}")
    println("r2={r2}")
    bool equal = (r1 == r2)
    println("equal={equal}")
    println("VTable-Overhead-1 done")
    return 0
}
