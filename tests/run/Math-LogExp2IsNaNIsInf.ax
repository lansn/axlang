// math.Log10 / math.Exp2 / math.IsNaN / math.IsInf（P1 第 2 项）
import math

int main() {
    println("{math.log10(100.0)}")
    println("{math.log10(1000.0)}")
    println("{math.log10(10.0)}")
    println("{math.exp2(1.0)}")
    println("{math.exp2(10.0)}")
    println("{math.exp2(0.0)}")
    println("{math.exp2(3.0)}")
    println("{math.isNan(math.log(-1.0))}")
    println("{math.isNan(math.sqrt(-1.0))}")
    println("{math.isNan(1.0)}")
    println("{math.isNan(math.log(10.0))}")
    println("{math.isInf(math.log(0.0), 1)}")
    println("{math.isInf(math.log(0.0), -1)}")
    println("{math.isInf(math.log(0.0), 0)}")
    println("{math.isInf(math.exp(1000.0), 1)}")
    println("{math.isInf(math.exp(1000.0), -1)}")
    println("{math.isInf(math.exp(1000.0), 0)}")
    println("{math.isInf(1.0, 0)}")
    return 0
}
