// ============================================================================
// axlang FFI 批量调用基准测试 —— FFI-Bench-2
// 验证：100 万次批量调用 C 库函数 abs，验证 FFI 调用开销与吞吐量
// 注意：abs 不产生 stdout 输出，保持测试输出确定性
// ============================================================================

extern "C" {
    int abs(int x);
}

int main() {
    const int N = 1000000

    // ---------- 测试：批量 FFI 调用 abs ----------
    int sum = 0
    for i in 0..N {
        int r = 0
        unsafe {
            r = abs(i - N / 2)
        }
        sum = sum + r
    }

    // 期望：sum_{i=0}^{N-1} abs(i - N/2)
    // N=1000000, N/2=500000
    // 左边 i=0..499999: 500000+499999+...+1 = 500000*500001/2 = 125,000,250,000
    // 右边 i=500001..999999: 1+2+...+499999 = 499999*500000/2 = 124,999,750,000
    // 总和 = 250,000,000,000
    int expected = 250000000000

    println("sum={sum}")
    println("expected={expected}")
    bool ok = (sum == expected)
    println("ok={ok}")
    println("FFI-Bench-2 done")
    return 0
}
