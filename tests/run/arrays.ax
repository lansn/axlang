// tests/run/arrays.ax —— 数组
import std.io
import std.strconv

int main() {
    var arr = [0, 0, 0, 0, 0]
    arr[0] = 1
    arr[1] = 2
    arr[2] = 3
    arr[3] = 4
    arr[4] = 5
    int total = 0
    for i in 0..5 {
        total = total + arr[i]
    }
    io.writeLine("total=")
    io.writeLine(strconv.itoa(total))
    io.writeLine("arr[0]=")
    io.writeLine(strconv.itoa(arr[0]))
    io.writeLine("arr[4]=")
    io.writeLine(strconv.itoa(arr[4]))
    return 0
}
