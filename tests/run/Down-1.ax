// 下转 T(x)：class 下转（父类→子类）、interface 下转（文稿 3.1，运行时 tag 检查）
class Animal {
    public string Name
    constructor(string name) { this.Name = name }
}
class Dog extend Animal {
    constructor(string name) { parent(name) }
}
interface Shape {
    string Describe()
}
class Circle implement Shape {
    public int R
    constructor(int r) { this.R = r }
    public override string Describe() { return "圆{this.R}" }
}
int main() {
    Animal a = new Dog("旺财")
    Dog d = Dog(a)
    println("下转 OK：{d.Name}")
    Shape s = new Circle(2)
    Circle c = Circle(s)
    println("接口下转 OK：{c.Describe()}")
    return 0
}
