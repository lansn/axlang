// maps.delete_func 测试（对标 Go maps.DeleteFunc，2026-11-25）
// 验证：删除所有使回调 f(key) 为 true 的键值对，其余保留
import maps

int main() {
    map<string, int> m = {"a": 1, "b": 2, "c": 3, "d": 4}
    func(string) bool f = (string k) {
        return k == "b" || k == "d"
    }
    maps.deleteFunc(m, f)
    println("剩余长度={m.len()}")
    println("a存在={m.has("a")}")
    println("b存在={m.has("b")}")
    println("c存在={m.has("c")}")
    println("d存在={m.has("d")}")
    return 0
}
