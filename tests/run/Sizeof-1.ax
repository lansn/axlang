// sizeof(expr)：编译期发 C 的 sizeof（文稿 11.2），返回实参类型的存储大小；
// class 按引用语义给指针大小（用户裁定，与赋值语义一致），对象大小不在此问
interface Shape { string Describe() }
class Dog implement Shape {
    public string Name
    public int Age
    constructor(string name) { this.Name = name; this.Age = 0 }
    public override string Describe() { return "狗" }
}
struct Point {
    int X
    int Y
}
int main() {
    int a = 1
    uint8 u = 1
    decimal d = 1.5d
    string s = "x"
    int[] xs = [1, 2]
    int[3] fix = [1, 2, 3]
    int? m = 5
    Dog dg = new Dog("旺财")
    Point pt = Point(1, 2)
    Shape sh = dg
    println(sizeof(a))
    println(sizeof(u))
    println(sizeof(d))
    println(sizeof(s))
    println(sizeof(xs))
    println(sizeof(fix))
    println(sizeof(m))
    println(sizeof(dg))
    println(sizeof(pt))
    println(sizeof(sh))
    println("表达式也行：{sizeof(a) + sizeof(s)}")
    println("{dg.Name} {pt.X} {sh.Describe()} {xs.Len()} {fix.Len()}")
    return 0
}
