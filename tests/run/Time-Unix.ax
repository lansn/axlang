// time 模块新增函数：Unix / UnixMilli / Since（对标 Go time.Unix/time.UnixMilli/time.Since）
// axlang time 为 Unix 毫秒（int64）。
import std.time

int main() {
    // Unix(0, 0) = Unix 纪元
    time t = std.time.unix(0, 0)
    println("unix-zero={t.toString()}")

    // UnixMilli(0) = Unix 纪元
    time t2 = std.time.unixMilli(0)
    println("unixmilli-zero={t2.toString()}")

    // UnixMilli(1000) = 1970-01-01 00:00:01
    time t3 = std.time.unixMilli(1000)
    println("unixmilli-1000={t3.toString()}")

    // Since(0) = 当前毫秒数，肯定大于 0
    println("since-zero-gt0={std.time.since(std.time.from_unix_ms(0)) > 0}")

    // Since(Now()) 应为 0 或极小值（< 1000 ms）
    time now = std.time.now()
    println("since-now-small={std.time.since(now) < 1000}")

    return 0
}
