// Printable：实现类插值 / 接口变量动态派发 / 可空有值 / 可空 null（GAP #12）
class Point implement Printable {
    public int X
    public int Y
    constructor(int x, int y) { this.X = x; this.Y = y }
    public override string ToString() {
        return "({this.X}, {this.Y})"
    }
}

int main() {
    Point p = new Point(3, 4)
    println("点：{p}")
    Printable q = p
    println("接口：{q}")
    Point? maybe = p
    println("可空：{maybe}")
    Point? none = null
    println("空：{none}")
    return 0
}
