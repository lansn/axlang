// Printable：实现类插值 / 接口变量动态派发 / 可空有值 / 可空 null（GAP #12）
class Point implement Printable {
    public int x
    public int y
    constructor(int x, int y) { this.x = x; this.y = y }
    public override string to_string() {
        return "({this.x}, {this.y})"
    }
}

int main() {
    Point p = new Point(3, 4)
    Println("点：{p}")
    Printable q = p
    Println("接口：{q}")
    Point? maybe = p
    Println("可空：{maybe}")
    Point? none = null
    Println("空：{none}")
    return 0
}
