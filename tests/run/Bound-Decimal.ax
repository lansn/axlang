// decimal 边界值测试：精确十进制金额计算，避免浮点误差
int main() {
    // 极小精度
    decimal a = 0.01d
    decimal b = 0.02d
    decimal c = a + b
    println("0.01+0.02={c}")   // 期望 0.03（不像 float 会是 0.030000000000000002）

    // 零
    decimal zero = 0d
    println("zero={zero}")

    // 整数字面量落地
    decimal lit = 42
    println("lit={lit}")

    // 乘法：decimal * int（GAP-1）
    decimal price = 19.99d
    int count = 3
    decimal total = price * count
    println("19.99*3={total}")   // 期望 59.97

    return 0
}
