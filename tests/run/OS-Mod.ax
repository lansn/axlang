// os 模块：Getenv / Args / Exit
import os

int main() {
    string e = os.getenv("AX_NONEXISTENT_VAR_12345")
    if e == "" {
        println("getenv-empty-ok")
    } else {
        println("getenv-empty-fail")
    }
    string[] args = os.args()
    println("args len={args.Len()}")
    os.exit(42)
    return 0
}
