// 类：继承 extend 与 override
class Animal {
    public string Name
    constructor(string name) {
        this.Name = name
    }
    public string Speak() {
        return "animal sound"
    }
}

class Dog extend Animal {
    constructor(string name) {
        parent(name)
    }
    public override string Speak() {
        return "woof"
    }
}

int main() {
    Dog d = new Dog("旺财")
    println(d.Speak())
    Animal a = d
    println(a.Speak())
    return 0
}
