// 类：继承 extend 与 override
class Animal {
    public string name
    constructor(string name) {
        this.name = name
    }
    public string speak() {
        return "animal sound"
    }
}

class Dog extend Animal {
    constructor(string name) {
        parent(name)
    }
    public override string speak() {
        return "woof"
    }
}

int main() {
    Dog d = new Dog("旺财")
    println(d.speak())
    Animal a = d
    println(a.speak())
    return 0
}
