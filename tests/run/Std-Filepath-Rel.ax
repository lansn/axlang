// 验证 std.filepath.rel（C 风格函数名）
import std.filepath

int main() {
    println("rel1={std.filepath.rel("a/b/c", "a/b/d")}")
    println("rel2={std.filepath.rel("a/b/c", "a/b/c/d")}")
    println("rel3={std.filepath.rel("a/b", "c/d")}")
    println("rel4={std.filepath.rel(".", "a/b")}")
    println("rel5={std.filepath.rel("a/b/c", "a/b/c")}")
    return 0
}
