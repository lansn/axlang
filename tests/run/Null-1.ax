// 可空值插值：有值显示值、无值显示 null（插值只做显示，不触发 E4001）
// 字面量落到可空类型也照常允许：`decimal?` 按内层 decimal 判落地规则（E4003 不误报）
int main() {
    string? a = "abc"
    string? b = null
    int? n = 7
    int? z = null
    Println("a={a} b={b} n={n} z={z}")

    decimal? d = 12.50d
    decimal? e = null
    float? f = 1.5
    bool? t = true
    Println("d={d} e={e} f={f} t={t}")
    return 0
}
