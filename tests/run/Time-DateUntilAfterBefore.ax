// time 模块新增函数：Date / Until / After / Before（对标 Go time，P1 第 3 项）
// axlang time 为 Unix 毫秒（int64）。
import std.time

int main() {
    // time.Date 按 UTC 组装年月日时分秒纳秒 -> time（Unix 毫秒），.toString() 按本地时区显示
    time t0 = std.time.date(1970, 1, 1, 0, 0, 0, 0)
    println("date-epoch={t0.toString()}")

    time t1 = std.time.date(1970, 1, 2, 0, 0, 0, 0)
    println("date-nextday={t1.toString()}")

    // time.until(t) = t - now；time.since(t) = now - t；二者互为相反数（确定性断言）
    time t = std.time.date(2026, 1, 1, 0, 0, 0, 0)
    println("until-neg-since={std.time.until(t) == -std.time.since(t)}")

    // time.After / time.Before（实例方法，按 Unix 毫秒比较）
    time a = std.time.date(2026, 1, 1, 0, 0, 0, 0)
    time b = std.time.date(2026, 12, 31, 0, 0, 0, 0)
    println("a-before-b={a.before(b)}")
    println("b-after-a={b.after(a)}")
    println("a-after-b={a.after(b)}")
    println("b-before-a={b.before(a)}")
    println("a-before-a={a.before(a)}")
    println("a-after-a={a.after(a)}")

    return 0
}
