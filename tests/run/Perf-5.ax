// ============================================================================
// axlang 亿级数据量基准测试 —— Perf-5
// 验证：1亿（100,000,000）次累加求和，不存储数组，避免内存占用
// 注意：输出为确定性计算结果，适合回归比对
// ============================================================================

int main() {
    const int N = 100000000

    // ---------- 测试：1亿次直接累加（不存储数组）----------
    int sum = 0
    for i in 0..N {
        sum = sum + i
    }

    // 期望：sum(0..99,999,999) = 4,999,999,950,000,000
    int expected = 4999999950000000

    println("1亿累加 sum={sum}")
    println("expected={expected}")
    bool ok = (sum == expected)
    println("ok={ok}")
    println("Perf-5 done")
    return 0
}
