// 内存安全：move 语义与重新赋值复活
class Buf {
    public int n
    constructor(int n) {
        this.n = n
    }
    public void write(string s) {
        this.n = this.n + s.len()
    }
}

int main() {
    var b = new Buf(8)
    var c = b
    b = new Buf(4)
    b.write("xy")
    println("b.n={b.n}")
    return 0
}
