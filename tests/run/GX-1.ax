// GX-01/02/06/07：泛型函数——推断、显式实参、多实例共存、嵌套实例化、
// 约束组合（Comparable + Printable）、实例体内的匿名函数（GAP 泛型 #1）
T max<T: Comparable>(T a, T b) {
    return if a > b { a } else { b }
}
T clamp<T: Comparable>(T x, T lo, T hi) {
    return max(max(x, lo), hi)
}
string pair<T: Printable>(T x, T y) {
    string s = "{x}"
    s = s + "|" + "{y}"
    return s
}
int apply<T>(T x, func(T) int f) {
    return f(x)
}
int main() {
    println(max(1, 2))
    println(max(2, 1))
    println(max(100, 42))
    println(max<string>("apple", "banana"))
    println(max<int>(7, 3))
    println(clamp(15, 1, 10))
    println(clamp(5, 1, 10))
    println(clamp<string>("m", "a", "z"))
    println(pair("头", "尾"))
    println(apply(42, (int v) { return v * 2 }))
    return 0
}
