// byte 类型：作为 uint8 的类型别名，映射到 C 的 uint8_t
// 验证 byte 变量声明、赋值、位运算、与 uint8 互操作

int main() {
    byte b = 0xFF
    uint8 u = 0x0F

    // 字面量赋值
    byte b1 = 0
    byte b2 = 255

    // byte 与 uint8 互相赋值（同一类型）
    byte b3 = u
    uint8 u2 = b

    // 位运算（仅用 byte 变量，避免与 int 字面量混合类型）
    byte b4 = b & u
    byte b5 = b | u
    byte b6 = b ^ u
    byte b7 = ~b

    // 左移/右移：移位量是 int，结果截断到 byte
    byte b8 = b << 4
    byte b9 = b >> 4

    // 算术运算
    byte b10 = b1 + b2      // 255 (截断)
    byte b11 = b2 - b1      // 255

    // 打印验证
    println("b={b}")
    println("u={u}")
    println("b3={b3}")
    println("u2={u2}")
    println("b4={b4}")
    println("b5={b5}")
    println("b6={b6}")
    println("b7={b7}")
    println("b8={b8}")
    println("b9={b9}")
    println("b10={b10}")
    println("b11={b11}")

    return 0
}
