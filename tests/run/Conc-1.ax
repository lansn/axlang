// 并发原语正例（ax 风格）：thread + queue<int> 生产者/消费者。
// 主线程启动生产者线程向阻塞队列推入 0..4，自身并发弹出并打印；
// 生产者关闭队列后，主线程收到 null 结束，最后打印 done。
// 单生产者 + FIFO 队列，弹出顺序确定为 0,1,2,3,4。
void producer(queue<int> q) {
    for i in 0..5 {
        q.Push(i)
    }
    q.Close()
}

int main() {
    queue<int> q = queue<int>()
    var t = thread(producer, q)
    for i in 0..100 {
        int? v = q.Pop()
        if v == null {
            break
        }
        println("{v}")
    }
    t.Join()
    println("done")
    return 0
}
