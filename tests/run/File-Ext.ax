// file.Remove / file.Rename / file.Exists / file.Mkdir
import file
import time

int main() {
    string dir = "tests/.build/file-ext-dir-{time.now_ms()}"
    string file1 = "tests/.build/file-ext-a.txt"
    string file2 = "tests/.build/file-ext-b.txt"

    // Mkdir（目录名唯一，必定不存在）
    int r1 = file.mkdir(dir)
    println("mkdir={r1}")

    // 创建文件
    var f = file.create(file1) try
    f.write_line("hello") try
    f.close()

    // Exists
    int r2 = file.exists(file1)
    println("exists-a={r2}")
    int r3 = file.exists("tests/.build/nonexistent.txt")
    println("exists-missing={r3}")

    // Rename
    int r4 = file.rename(file1, file2)
    println("rename={r4}")
    int r5 = file.exists(file2)
    println("exists-b={r5}")
    int r6 = file.exists(file1)
    println("exists-a-after-rename={r6}")

    // Remove
    int r7 = file.remove(file2)
    println("remove={r7}")
    int r8 = file.exists(file2)
    println("exists-b-after-remove={r8}")

    // Remove 不存在的文件
    int r9 = file.remove("tests/.build/nonexistent.txt")
    println("remove-missing={r9}")

    return 0
}
