// ============================================================================
// axlang 多线程通信测试 —— ThreadSafe-6（模式 3：多工作线程汇总）
// 验证：多个工作线程各独立队列，主线程逐个 Pop 汇总结果，完成计数器
// 注意：queue<T> 是所有权类型，不能多线程共享同一队列指针
// ============================================================================

// 工作线程：计算并 Push 结果，Close 发送结束信号
void worker(queue<int> q) {
    int result = 0
    for i in 0..1000 {
        result = result + i
    }
    q.Push(result)
    q.Close()
}

int main() {
    const int N = 8

    // 8 个独立队列，每个线程一个
    queue<int> q1 = queue<int>()
    queue<int> q2 = queue<int>()
    queue<int> q3 = queue<int>()
    queue<int> q4 = queue<int>()
    queue<int> q5 = queue<int>()
    queue<int> q6 = queue<int>()
    queue<int> q7 = queue<int>()
    queue<int> q8 = queue<int>()

    var t1 = thread(worker, q1)
    var t2 = thread(worker, q2)
    var t3 = thread(worker, q3)
    var t4 = thread(worker, q4)
    var t5 = thread(worker, q5)
    var t6 = thread(worker, q6)
    var t7 = thread(worker, q7)
    var t8 = thread(worker, q8)

    // 模式 3：主线程逐个 Pop 汇总（完成计数器）
    int total = 0
    int done_count = 0

    int? v = null

    v = q1.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q2.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q3.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q4.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q5.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q6.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q7.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }
    v = q8.Pop()
    if v != null {
        total = total + v
        done_count = done_count + 1
    }

    // 回收所有线程资源
    t1.Join()
    t2.Join()
    t3.Join()
    t4.Join()
    t5.Join()
    t6.Join()
    t7.Join()
    t8.Join()

    // 期望：8 * 499500 = 3996000
    int expected = 3996000
    bool ok = (total == expected && done_count == N)

    println("total={total}")
    println("done_count={done_count}")
    println("expected={expected}")
    println("ok={ok}")
    println("ThreadSafe-6 done")
    return 0
}
