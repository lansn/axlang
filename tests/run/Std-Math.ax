// 验证 std.math 模块（C 风格函数名）
import std.math

int main() {
    var a = std.math.abs(-5.0)
    println("abs={a}")
    var b = std.math.max(3.0, 7.0)
    println("max={b}")
    var c = std.math.min(3.0, 7.0)
    println("min={c}")
    var d = std.math.sqrt(16.0)
    println("sqrt={d}")
    var e = std.math.pow(2.0, 3.0)
    println("pow={e}")
    var f = std.math.sin(0.0)
    println("sin={f}")
    var g = std.math.cos(0.0)
    println("cos={g}")
    var h = std.math.isnan(0.0)
    println("isnan={h}")
    return 0
}
