// ============================================================================
// axlang 多线程安全测试 —— ThreadSafe-8
// 验证：N 个生产者线程向同一个 queue<int> Push，主线程 Pop 汇总
//
// 设计：
//   1. 主线程创建一个 queue<int>，启动 N 个生产者线程
//   2. 每个生产者向同一队列 Push BATCH 个元素（0..BATCH-1）
//   3. 主线程阻塞 Pop 固定次数（N*BATCH），汇总求和
//   4. 所有元素消费完毕后，主线程 Close 队列，Join 所有生产者
//
// 注意：queue<T> 在 C 层为 ax_queue* 指针，thread(func, arg) 将 arg 作为
// void* 上下文传入。同一队列指针可被多个线程持有副本，C 层 ax_queue_push
// 内部加锁，天然线程安全，无数据竞争、无丢失、无重复。
//
// 期望：每个生产者 Push 0..999，和为 499500；N=4 个生产者总和 1998000。
// ============================================================================

const int N = 4
const int BATCH = 1000

// 生产者：向共享队列推入 0..BATCH-1（不 Close，由主线程统一 Close）
void producer(queue<int> q) {
    for i in 0..BATCH {
        q.Push(i)
    }
}

int main() {
    // 创建单个共享队列
    queue<int> q = queue<int>()

    // 启动 N 个生产者线程，全部向同一个队列 Push
    var t1 = thread(producer, q)
    var t2 = thread(producer, q)
    var t3 = thread(producer, q)
    var t4 = thread(producer, q)

    // 主线程阻塞 Pop 固定次数（N*BATCH），汇总求和
    // Pop 是阻塞的：若队列暂时为空，主线程会等待生产者 Push 新元素
    int total = 0
    int expected_count = N * BATCH
    for i in 0..expected_count {
        int? v = q.Pop()
        if v != null {
            total = total + v
        }
    }

    // 所有元素已消费完毕，关闭队列并回收线程资源
    q.Close()
    t1.Join()
    t2.Join()
    t3.Join()
    t4.Join()

    // 期望：N * (0+1+...+999) = 4 * 499500 = 1998000
    int expected = 1998000
    println("total={total}")
    println("expected={expected}")
    bool ok = (total == expected)
    println("ok={ok}")
    println("ThreadSafe-8 done")
    return 0
}
