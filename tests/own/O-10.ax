// EXPECT: E7001
// O-10：分支内 move，汇合点保守视为已移走（GAP-13）
// ——注意 else 分支内的使用本身合法（两支状态互不泄漏，不误报）
bool yes() {
    return true
}

class Buf {
    public int n
    constructor(int n) {
        this.n = n
    }
    public void write(string s) {
        this.n = this.n + s.Len()
    }
}

void sink(Buf b) {
}

int main() {
    var b = new Buf(1)
    if yes() {
        sink(b)
    } else {
        b.write("x")
    }
    b.write("y")
    return 0
}
