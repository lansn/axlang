// EXPECT: E7006
// O-18：ArenaRef 不能存进普通对象（区域外）的字段——
// 构造期也一样拦截（Holder 的字段赋值就发生在普通对象上）
class Node {
    public int v
    constructor(int v) {
        this.v = v
    }
}

class Holder {
    public ArenaRef<Node> slot
    constructor(ArenaRef<Node> s) {
        this.slot = s
    }
}

int main() {
    var arena = new Arena()
    ArenaRef<Node> a = arena.alloc(new Node(1))
    var h = new Holder(a)
    return 0
}
