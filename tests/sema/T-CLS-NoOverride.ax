// EXPECT: E3017
// 人类常犯：子类覆写了父类方法但没写 override
class Animal {
    public string speak() {
        return "声音"
    }
}

class Dog extend Animal {
    constructor(string name) {
        parent(name)
    }

    public string speak() {
        return "汪汪"
    }
}

int main() {
    Dog d = new Dog("旺财")
    return 0
}
