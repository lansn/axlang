// axc/std/sync.ax —— axlang 标准库 sync 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go sync。Mutex/RWMutex/WaitGroup/Once 为 axlang 内建句柄类型，
// 零初始化后直接使用。本文件仅在 ax 层包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入任何 ax 编译器内建能力。
//
// 导出函数命名采用 C 风格：全部小写，下划线分隔，如 mutex_lock / waitgroup_add。
// ax 代码中通过 std.sync.mutexLock(m) 调用。

extern "C" {
    void ax_mutex_lock(ref Mutex m);
    void ax_mutex_unlock(ref Mutex m);
    void ax_rwmutex_lock(ref RWMutex rw);
    void ax_rwmutex_unlock(ref RWMutex rw);
    void ax_rwmutex_rlock(ref RWMutex rw);
    void ax_rwmutex_runlock(ref RWMutex rw);
    void ax_waitgroup_add(ref WaitGroup wg, int delta);
    void ax_waitgroup_done(ref WaitGroup wg);
    void ax_waitgroup_wait(ref WaitGroup wg);
    void ax_once_do(ref Once o);
}

/**
 * 函数名：mutexLock
 * 功能：对互斥锁 m 加锁，阻塞直到获得锁
 * 输入参数：m (ref Mutex) - 互斥锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void mutexLock(ref Mutex m) {
    unsafe {
        ax_mutex_lock(m)
    }
}

/**
 * 函数名：mutexUnlock
 * 功能：对互斥锁 m 解锁
 * 输入参数：m (ref Mutex) - 互斥锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void mutexUnlock(ref Mutex m) {
    unsafe {
        ax_mutex_unlock(m)
    }
}

/**
 * 函数名：rwmutexLock
 * 功能：对读写锁 rw 加写锁，阻塞直到获得锁
 * 输入参数：rw (ref RWMutex) - 读写锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void rwmutexLock(ref RWMutex rw) {
    unsafe {
        ax_rwmutex_lock(rw)
    }
}

/**
 * 函数名：rwmutexUnlock
 * 功能：对读写锁 rw 解写锁
 * 输入参数：rw (ref RWMutex) - 读写锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void rwmutexUnlock(ref RWMutex rw) {
    unsafe {
        ax_rwmutex_unlock(rw)
    }
}

/**
 * 函数名：rwmutexRLock
 * 功能：对读写锁 rw 加读锁，阻塞直到获得锁
 * 输入参数：rw (ref RWMutex) - 读写锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void rwmutexRLock(ref RWMutex rw) {
    unsafe {
        ax_rwmutex_rlock(rw)
    }
}

/**
 * 函数名：rwmutexRunlock
 * 功能：对读写锁 rw 解读锁
 * 输入参数：rw (ref RWMutex) - 读写锁引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void rwmutexRunlock(ref RWMutex rw) {
    unsafe {
        ax_rwmutex_runlock(rw)
    }
}

/**
 * 函数名：waitgroupAdd
 * 功能：为等待组 wg 添加 delta 个计数
 * 输入参数：wg (ref WaitGroup) - 等待组引用；delta (int) - 增加的计数值
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void waitgroupAdd(ref WaitGroup wg, int delta) {
    unsafe {
        ax_waitgroup_add(wg, delta)
    }
}

/**
 * 函数名：waitgroupDone
 * 功能：为等待组 wg 的计数减 1
 * 输入参数：wg (ref WaitGroup) - 等待组引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void waitgroupDone(ref WaitGroup wg) {
    unsafe {
        ax_waitgroup_done(wg)
    }
}

/**
 * 函数名：waitgroupWait
 * 功能：阻塞直到等待组 wg 的计数为 0
 * 输入参数：wg (ref WaitGroup) - 等待组引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void waitgroupWait(ref WaitGroup wg) {
    unsafe {
        ax_waitgroup_wait(wg)
    }
}

/**
 * 函数名：onceDo
 * 功能：确保只执行一次，适用于单例初始化
 * 输入参数：o (ref Once) - Once 控制引用
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void onceDo(ref Once o) {
    unsafe {
        ax_once_do(o)
    }
}
