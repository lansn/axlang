		{"trigger": ".Contains", "contents": ".Contains(${1:sub})"},
		{"trigger": ".IndexOf", "contents": ".IndexOf(${1:sub})"},
		{"trigger": ".LastIndexOf", "contents": ".LastIndexOf(${1:sub})"},
		{"trigger": ".Split", "contents": ".Split(${1:sep})"},
		{"trigger": ".Trim", "contents": ".Trim()"},
		{"trigger": ".Left", "contents": ".Left(${1:n})"},
		{"trigger": ".Right", "contents": ".Right(${1:n})"},
		{"trigger": ".Mid", "contents": ".Mid(${1:start}, ${2:n})"},
		{"trigger": ".Upper", "contents": ".Upper()"},
		{"trigger": ".Lower", "contents": ".Lower()"},
		{"trigger": ".StartsWith", "contents": ".StartsWith(${1:p})"},
		{"trigger": ".EndsWith", "contents": ".EndsWith(${1:p})"},
		{"trigger": ".Join", "contents": ".Join(${1:parts})"},
		{"trigger": ".Replace", "contents": ".Replace(${1:old}, ${2:new})"},
		{"trigger": ".Repeat", "contents": ".Repeat(${1:n})"},
		{"trigger": ".ToString", "contents": ".ToString()"},

		// ===== 数组实例方法 =====
		{"trigger": ".Push", "contents": ".Push(${1:v})"},
		{"trigger": ".Pop", "contents": ".Pop()"},
		{"trigger": ".Remove", "contents": ".Remove(${1:i})"},
		{"trigger": ".Clear", "contents": ".Clear()"},
		{"trigger": ".Sort", "contents": ".Sort(${1:cmp})"},

		// ===== map 实例方法 =====
		{"trigger": ".Get", "contents": ".Get(${1:key})"},
		{"trigger": ".Keys", "contents": ".Keys()"},
		{"trigger": ".Has", "contents": ".Has(${1:key})"},

		// ===== decimal / int / Rounding =====
		{"trigger": ".Round", "contents": ".Round(${1:scale}, Rounding.${2:HalfUp})"},
		{"trigger": ".Divide", "contents": ".Divide(${1:other}, ${2:scale}, Rounding.${3:HalfUp})"},
		{"trigger": ".WrappingAdd", "contents": ".WrappingAdd(${1:y})"},
		{"trigger": ".Truncate", "contents": "Truncate(${1:x})"},
		{"trigger": "Rounding.HalfUp", "contents": "Rounding.HalfUp"},
		{"trigger": "Rounding.HalfEven", "contents": "Rounding.HalfEven"},
		{"trigger": "Rounding.Down", "contents": "Rounding.Down"},

		// ===== File / Row 实例方法 =====
		{"trigger": ".Close", "contents": ".Close()"},
		{"trigger": ".Read", "contents": ".Read()"},
		{"trigger": ".ReadLine", "contents": ".ReadLine()"},
		{"trigger": ".Write", "contents": ".Write(${1:s})"},
		{"trigger": ".WriteLine", "contents": ".WriteLine(${1:s})"},
		{"trigger": ".Empty", "contents": ".Empty()"},
		{"trigger": ".GetString", "contents": ".GetString(${1:col})"},
		{"trigger": ".GetInt", "contents": ".GetInt(${1:col})"},
		{"trigger": ".GetDecimal", "contents": ".GetDecimal(${1:col})"},

		// ===== time 实例方法 =====
		{"trigger": ".UnixMs", "contents": ".UnixMs()"},
		{"trigger": ".Format", "contents": ".Format(${1:fmt})"},

		// ===== 静态解析 =====
		{"trigger": ".Parse", "contents": ".Parse(${1:s})"}
	]
}
