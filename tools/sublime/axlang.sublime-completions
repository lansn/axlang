		{"trigger": "json.Parse", "contents": "json.Parse(${1:s})"},
		{"trigger": "json.Stringify", "contents": "json.Stringify(${1:v})"},
		{"trigger": "math.Equals", "contents": "math.Equals(${1:a}, ${2:b}, ${3:eps})"},
		{"trigger": "math.Compare", "contents": "math.Compare(${1:a}, ${2:b})"},
		{"trigger": "string.FromCodepoint", "contents": "string.FromCodepoint(${1:cp})"},
		{"trigger": "time.Now", "contents": "time.Now()"},
		{"trigger": "time.NowMs", "contents": "time.NowMs()"},
		{"trigger": "time.FromUnixMs", "contents": "time.FromUnixMs(${1:ms})"},

		// ===== string 实例方法 =====
		{"trigger": ".Len", "contents": ".Len()"},
		{"trigger": ".ByteLen", "contents": ".ByteLen()"},
		{"trigger": ".At", "contents": ".At(${1:i})"},
		{"trigger": ".Chars", "contents": ".Chars()"},
