{
	// axlang 语法提示（Sublime Text 自动补全）
	// 依据 rust/src/frontend/lexer.rs 与 docs/STDLIB.md 生成
	// 安装：与 axlang.sublime-syntax 一同放入 Packages/User/ 或 Packages/axlang/
	"scope": "source.ax",

	"completions": [
		// ===== 关键字 =====
		{"trigger": "var", "contents": "var ${1:name} = ${2:value}"},
		{"trigger": "const", "contents": "const ${1:NAME} = ${2:value}"},
		{"trigger": "class", "contents": "class ${1:Name} {\n\tpublic ${2:int} ${3:field}\n\n\tpublic constructor(${4:args}) {\n\t\tthis.${3:field} = ${4:args}\n\t}\n}"},
		{"trigger": "struct", "contents": "struct ${1:Name} {\n\t${2:int} ${3:field}\n}"},
		{"trigger": "interface", "contents": "interface ${1:Name} {\n\tpublic ${2:string} ${3:Method}()\n}"},
		{"trigger": "enum", "contents": "enum ${1:Name} {\n\t${2:MemberA}\n\t${3:MemberB}\n}"},
		{"trigger": "extend", "contents": "extend ${1:Parent}"},
		{"trigger": "implement", "contents": "implement ${1:Interface}"},
		{"trigger": "if", "contents": "if ${1:cond} {\n\t${2}\n}"},
		{"trigger": "ifelse", "contents": "if ${1:cond} {\n\t${2}\n} else {\n\t${3}\n}"},
		{"trigger": "else", "contents": "else {\n\t${1}\n}"},
		{"trigger": "for", "contents": "for ${1:x} in ${2:0..10} {\n\t${3}\n}"},
		{"trigger": "forin", "contents": "for ${1:x} in ${2:items} {\n\t${3}\n}"},
		{"trigger": "while", "contents": "while ${1:cond} {\n\t${2}\n}"},
		{"trigger": "match", "contents": "match ${1:value} {\n\t${2:pattern} => ${3}\n\t_ => ${4}\n}"},
		{"trigger": "return", "contents": "return ${1:value}"},
		{"trigger": "try", "contents": "try ${1:expr}"},
		{"trigger": "trycatch", "contents": "try {\n\t${1}\n} catch ${2:e} {\n\t${3}\n} finally {\n\t${4}\n}"},
		{"trigger": "catch", "contents": "catch ${1:e} {\n\t${2}\n}"},
		{"trigger": "finally", "contents": "finally {\n\t${1}\n}"},
		{"trigger": "throw", "contents": "throw ${1:e}"},
		{"trigger": "defer", "contents": "defer ${1:cleanup()}"},
		{"trigger": "import", "contents": "import ${1:json}"},
		{"trigger": "importas", "contents": "import ${1:json} as ${2:j}"},
		{"trigger": "new", "contents": "new ${1:Name}(${2})"},
		{"trigger": "constructor", "contents": "public constructor(${1:args}) {\n\t${2}\n}"},

		// ===== 内建类型 =====
		{"trigger": "int", "contents": "int"},
		{"trigger": "int8", "contents": "int8"},
		{"trigger": "int16", "contents": "int16"},
		{"trigger": "int32", "contents": "int32"},
		{"trigger": "uint", "contents": "uint"},
		{"trigger": "uint8", "contents": "uint8"},
		{"trigger": "uint16", "contents": "uint16"},
		{"trigger": "uint32", "contents": "uint32"},
		{"trigger": "float", "contents": "float"},
		{"trigger": "decimal", "contents": "decimal"},
		{"trigger": "string", "contents": "string"},
		{"trigger": "bool", "contents": "bool"},
		{"trigger": "object", "contents": "object"},
		{"trigger": "void", "contents": "void"},
		{"trigger": "result", "contents": "result<${1:T}>"},
		{"trigger": "error", "contents": "error"},
		{"trigger": "map", "contents": "map<${1:string}, ${2:object}>"},
		{"trigger": "func", "contents": "func(${1:T}) ${2:T}"},
		{"trigger": "range", "contents": "range"},
		{"trigger": "Rounding", "contents": "Rounding"},

		// ===== 全局函数 =====
		{"trigger": "print", "contents": "print(${1:s})"},
		{"trigger": "println", "contents": "println(${1:s})"},
		{"trigger": "ok", "contents": "ok(${1:v})"},
		{"trigger": "fail", "contents": "fail(${1:e})"},
		{"trigger": "typeof", "contents": "typeof(${1:expr})"},
		{"trigger": "sizeof", "contents": "sizeof(${1:expr})"},
		{"trigger": "parent", "contents": "parent(${1:args})"},
		{"trigger": "len", "contents": "len(${1:x})"},
		{"trigger": "max", "contents": "max(${1:a}, ${2:b})"},
		{"trigger": "min", "contents": "min(${1:a}, ${2:b})"},

		// ===== 内建模块成员 =====
		{"trigger": "db.Query", "contents": "db.Query(${1:sql})"},
		{"trigger": "file.Open", "contents": "file.Open(${1:path})"},
		{"trigger": "file.Create", "contents": "file.Create(${1:path})"},
		{"trigger": "file.Append", "contents": "file.Append(${1:path})"},
		{"trigger": "io.ReadLine", "contents": "io.ReadLine()"},
