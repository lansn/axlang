# Build and Release Folders

# Rust 构建产物（cargo 自己生成，几百 MB，绝不入库）
/rust/target/

# 测试临时目录：编译器跑用例时把 .c / 可执行文件落在这里
/tests/.build/

# 编辑器 / 系统
.DS_Store
Thumbs.db

# Other files and folders
.tmp/

# WorkBuddy 本地项目内存与工作日志，不应入库
.workbuddy/

# 测试临时目录（根目录）
/.build/

# Executables
# 注意：`/release/bin/axc.exe` 是刻意跟踪的——分发用的编译器本体，
# 与源码版本号同步更新，不进忽略清单。
# 编译过程中在 rust/ 根目录产出的 axc.exe 不应入库
/rust/main.exe
# 发布目录中的编译器二进制和 gcc 工具链需要入库
!/release/bin/axc.exe
!/release/gcc/bin/gcc.exe
# *.swf
# *.air
# *.ipa
# *.apk
# *.exe

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
