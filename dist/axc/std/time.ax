// axc/std/time.ax —— axlang 标准库 time 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go time / C time.h。ax 层仅包装 axrt C 时间原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 camelCase 风格，如 nowMs / unixMilli / since。
// ax 代码中通过 std.time.nowMs(...) 调用模块级函数。
//
// 类型说明：time 是 axlang 的内建具名类型（C 层 int64_t），与 int 在 ax 类型
// 系统中不做隐式转换，且 ax 无显式 cast 语法。因此：
//   * now() 需要 time ← ax_now_ms(int)，无法在 ax 源码中表达，继续沿用内建
//     codegen 分支 `("time", "now")`；
//   * time.parse 返回 result<time>，涉及运行时结果类型，同暂不独立包装，
//     继续沿用内建 codegen 分支 `("time", "parse")`。
// 其余模块级函数在此处以 ax 源码包装 axrt 原语（axrt 中对应原语均为 int64_t）。

extern "C" {
    /* axrt 时间原语（axc/rt/axrt_time.c） */
    int ax_now_ms();
    time ax_time_now();
    void ax_time_sleep(int ms);
    time ax_time_from_unix(int sec, int nsec);
    time ax_time_from_unix_ms(int ms);
    time ax_time_from_unix_us(int us);
    time ax_time_from_unix_ns(int nsec);
    int ax_time_since(time t);
    time ax_time_date(int year, int month, int day,
                      int hour, int min, int sec, int nsec);
    int ax_time_until(time t);

    /* axrt 时间扩展原语（对标 Go time，标准 C11 实现） */
    string ax_time_to_str(int ms);
    time ax_time_round(time t, int d);
    time ax_time_truncate(time t, int d);
}

// ---------- 模块级函数（camelCase 命名） ----------

/**
 * 函数名：nowMs
 * 功能：返回当前时间的毫秒时间戳（Unix 时间戳，整数）
 * 输入参数：无
 * 输出参数：int - 当前时间的毫秒时间戳
 * 修订日期：2026-11-27
 */
public int nowMs() {
    unsafe {
        return ax_now_ms()
    }
}

/**
 * 函数名：now
 * 功能：返回当前的 time 值
 * 输入参数：无
 * 输出参数：time - 当前时间值
 * 修订日期：2026-11-27
 */
public time now() {
    unsafe {
        return ax_time_now()
    }
}

/**
 * 函数名：sleep
 * 功能：休眠指定的毫秒数
 * 输入参数：ms (int) - 休眠毫秒数
 * 输出参数：无
 * 修订日期：2026-11-27
 */
public void sleep(int ms) {
    unsafe {
        ax_time_sleep(ms)
    }
}

/**
 * 函数名：unix
 * 功能：根据秒和纳秒构造 time 值
 * 输入参数：sec (int) - 秒；nsec (int) - 纳秒
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time unix(int sec, int nsec) {
    unsafe {
        return ax_time_from_unix(sec, nsec)
    }
}

/**
 * 函数名：unixMilli
 * 功能：根据毫秒时间戳构造 time 值
 * 输入参数：ms (int) - 毫秒时间戳
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time unixMilli(int ms) {
    unsafe {
        return ax_time_from_unix_ms(ms)
    }
}

/**
 * 函数名：fromUnixMs
 * 功能：根据毫秒时间戳构造 time 值（与 unixMilli 相同）
 * 输入参数：ms (int) - 毫秒时间戳
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time fromUnixMs(int ms) {
    unsafe {
        return ax_time_from_unix_ms(ms)
    }
}

/**
 * 函数名：unixMicro
 * 功能：根据微秒时间戳构造 time 值
 * 输入参数：us (int) - 微秒时间戳
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time unixMicro(int us) {
    unsafe {
        return ax_time_from_unix_us(us)
    }
}

/**
 * 函数名：unixNano
 * 功能：根据纳秒时间戳构造 time 值
 * 输入参数：nsec (int) - 纳秒时间戳
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time unixNano(int nsec) {
    unsafe {
        return ax_time_from_unix_ns(nsec)
    }
}

/**
 * 函数名：since
 * 功能：返回从 t 到现在经过的毫秒数
 * 输入参数：t (time) - 起始时间值
 * 输出参数：int - 经过的毫秒数
 * 修订日期：2026-11-27
 */
public int since(time t) {
    unsafe {
        return ax_time_since(t)
    }
}

/**
 * 函数名：date
 * 功能：根据日期时间构造 time 值
 * 输入参数：year (int) - 年；month (int) - 月；day (int) - 日；hour (int) - 时；min (int) - 分；sec (int) - 秒；nsec (int) - 纳秒
 * 输出参数：time - 构造的时间值
 * 修订日期：2026-11-27
 */
public time date(int year, int month, int day, int hour, int min, int sec, int nsec) {
    unsafe {
        return ax_time_date(year, month, day, hour, min, sec, nsec)
    }
}

/**
 * 函数名：until
 * 功能：返回从现在到 t 的剩余毫秒数
 * 输入参数：t (time) - 目标时间值
 * 输出参数：int - 剩余毫秒数
 * 修订日期：2026-11-27
 */
public int until(time t) {
    unsafe {
        return ax_time_until(t)
    }
}

/**
 * 函数名：toString
 * 功能：按 "YYYY-MM-DD HH:MM:SS" 格式将毫秒时间戳格式化为字符串
 * 输入参数：ms (int) - Unix 毫秒时间戳
 * 输出参数：string - 格式化后的时间字符串
 * 修订日期：2026-11-30
 */
public string toString(int ms) {
    unsafe {
        return ax_time_to_str(ms)
    }
}

/**
 * 函数名：round
 * 功能：将时间 t 四舍五入到 d 毫秒间隔的最近整数倍（d <= 0 时返回 t 本身）
 * 输入参数：t (time) - 起始时间值；d (int) - 间隔毫秒数
 * 输出参数：time - 舍入后的时间值
 * 修订日期：2026-11-30
 */
public time round(time t, int d) {
    unsafe {
        return ax_time_round(t, d)
    }
}

/**
 * 函数名：truncate
 * 功能：将时间 t 向零截断到 d 毫秒间隔的整数倍（d <= 0 时返回 t 本身）
 * 输入参数：t (time) - 起始时间值；d (int) - 间隔毫秒数
 * 输出参数：time - 截断后的时间值
 * 修订日期：2026-11-30
 */
public time truncate(time t, int d) {
    unsafe {
        return ax_time_truncate(t, d)
    }
}
