// axc/std/bufio.ax —— axlang 标准库 bufio 模块（ax 语法源码）
// 与用户库一样，由 ax 编译器直接解析，生成对应的 C 源码供 gcc 编译。
//
// 对标 Go bufio。ax 层仅包装 axrt C 原语，
// 通过 extern "C" 声明 + unsafe 块调用，不引入 ax 编译器内建能力。
//
// 导出函数命名采用 camelCase 风格，如 newReader / newWriter / scanner。
// ax 代码中通过 std.bufio.newReader(...) 调用模块级函数。

extern "C" {
    File ax_file_buf_reader(File f);
    File ax_file_buf_writer(File f);
    File ax_file_buf_scanner(File f);
}

// ---------- 模块级函数（camelCase 命名） ----------

/**
 * 函数名：newReader
 * 功能：为文件 r 创建带缓冲的读取器
 * 输入参数：r (File) - 要包装的文件句柄
 * 输出参数：File - 带缓冲的读取器句柄
 * 修订日期：2026-11-27
 */
public File newReader(File r) {
    unsafe {
        return ax_file_buf_reader(r)
    }
}

/**
 * 函数名：newWriter
 * 功能：为文件 w 创建带缓冲的写入器
 * 输入参数：w (File) - 要包装的文件句柄
 * 输出参数：File - 带缓冲的写入器句柄
 * 修订日期：2026-11-27
 */
public File newWriter(File w) {
    unsafe {
        return ax_file_buf_writer(w)
    }
}

/**
 * 函数名：scanner
 * 功能：为文件 r 创建扫描器
 * 输入参数：r (File) - 要扫描的文件句柄
 * 输出参数：File - 扫描器句柄
 * 修订日期：2026-11-27
 */
public File scanner(File r) {
    unsafe {
        return ax_file_buf_scanner(r)
    }
}
