// 模块 checkout.wholesale —— 跨模块继承：父类在 catalog.product 里
//
// 用 `import catalog.product` 拿到模块视图，继承时写 `extend product.Product`。

import catalog.product

public class WholesaleProduct extend product.Product {
    public int MinQty

    constructor(string sku, string name, decimal price, int min_qty) {
        parent(sku, name, price)          // 父类构造必须是第一条语句
        this.MinQty = min_qty
    }

    public string BatchLabel() {
        return "{this.Label()}，{this.MinQty} 件起订"
    }
}
