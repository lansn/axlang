// OrderDemo —— 多模块 + 类的引入与调用（可直接运行）
//
//   axc run samples/demo/OrderDemo/main.ax
//
// 目录结构即模块结构：catalog/product.ax 的模块名是 catalog.product。
// import 之后类型名直接写 `Product` 即可——`product.Product`（末段短名）与
// `catalog.product.Product`（全路径）同样合法，三者指向同一个类。
// 只有两个模块导出同名类型时，才必须写全路径（否则报 E3042）。

import catalog.product
import catalog.inventory
import checkout.bill as bill
import checkout.wholesale

int main() {
    // ---- 1. 裸名构造：import 已经把类型引进作用域 ----
    Product kb = new Product("SKU-001", "机械键盘", 299.00d)
    println("{kb.label()} ¥{kb.price:.2}")
    println("含税：¥{kb.priceWithTax():.2}")

    // ---- 2. 另一个模块的类：构造、调用、把对象交出去 ----
    Inventory inv = new Inventory()
    inv.add(kb)                                    // 交出去之后 kb 归 inv 所有
    inv.add(new catalog.product.Product("SKU-002", "无线鼠标", 99.00d))   // 全路径写法
    println("入库 {inv.items.len()} 件，合计 ¥{inv.total():.2}")

    // ---- 3. 可空返回：查到用，查不到走 else ----
    var hit = inv.find("SKU-002")
    if hit != null {
        println("查到 {hit.label()}")
    } else {
        println("未找到")
    }
    var miss = inv.find("SKU-999")
    if miss == null {
        println("SKU-999 未找到")
    }

    // ---- 4. 具名导入的模块：Bill 自己管账 ----
    Bill b = new Bill()
    b.add(new Product("SKU-001", "机械键盘", 299.00d))
    b.add(new Product("SKU-002", "无线鼠标", 99.00d))
    println("小计 ¥{b.subtotal():.2} 税 ¥{b.tax():.2} 合计 ¥{b.total():.2}")

    // ---- 5. 跨模块继承：批发品复用 Product 的 Label ----
    WholesaleProduct wp = new WholesaleProduct("SKU-101", "显示器", 1299.00d, 12)
    println(wp.batchLabel())
    return 0
}
