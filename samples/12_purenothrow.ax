// 12_purenothrow.ax —— @pure / @nothow 属性与 const 编译期断言
//
//   axc run samples/12_purenothrow.ax
//
// 零新增关键词：@pure / @nothrow 复用已有的 @ 属性机制（与 @os、@arch 同一套）；
// 编译期断言用 `const bool _check = 条件;` 表达，条件为 false 时 E6016 停止编译，
// 不产生任何运行期代码。

// @pure：无副作用的纯函数。编译期检查：函数体内不得调用非 @pure 函数。
@pure
int add(int a, int b) {
    return a + b
}

@pure
int square(int x) {
    return x * x
}

// @nothrow：不抛错误的函数。编译期检查：函数体内不得 throw / 调用可能抛错的函数。
@nothrow
int safe_div(int a, int b) {
    if b == 0 {
        return 0
    }
    return a / b
}

// 两个属性可组合：连续书写。
@pure @nothrow
int max(int a, int b) {
    if a >= b {
        return a
    }
    return b
}

// 编译期断言：const 常量求值为 false 时编译失败（E6016），零运行期开销。
// 仅字面量与 is T 属于编译期常量表达式（axlang 暂不支持 const 函数求值）。
// 这里写在 main 内部，编译该函数时即检查。

int main() {
    const bool _check1 = 1 + 1 == 2
    const bool _check2 = 3 > 2
    const bool _check3 = is(int == int)

    println("add(2, 3) = {add(2, 3)}")
    println("square(4) = {square(4)}")
    println("safe_div(6, 3) = {safe_div(6, 3)}")
    println("safe_div(6, 0) = {safe_div(6, 0)}   // 除零不抛错，返回 0")
    println("max(7, 3) = {max(7, 3)}")
    println("1 + 1 == 2 -> {_check1}")
    println("3 > 2 -> {_check2}")
    println("is(int == int) -> {_check3}")
    println("全部编译期断言通过，程序正常结束")
    return 0
}
