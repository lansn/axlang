// 09_trap.ax —— 七类崩溃的唯一路径（R101..R107）
//
// 运行期只在这七种情况下崩，崩溃信息固定四行、退出码固定 2。
// 本文件默认演示 R101；改 TRAP 常量即可换一种（1..7 对应 R101..R107）。
//
//   axc run samples/09_trap.ax
//   echo $?        # 2

import strconv

const int TRAP = 1

int main() {
    if TRAP == 1 {
        // R101 下标越界：动态数组的下标在运行期检查
        int[] a = [1, 2, 3]
        int i = 5
        println("{a[i]}")
    }
    if TRAP == 2 {
        // R102 整数除零
        int z = 0
        println("{1 / z}")
    }
    if TRAP == 3 {
        // R103 decimal 除不尽（金额不允许悄悄近似）
        decimal u = 100.00d / 3d
        println("{u}")
    }
    if TRAP == 4 {
        // R104 整数溢出（wrapping_add 才是显式取回绕）
        int m = 9223372036854775807
        println("{m + 1}")
    }
    if TRAP == 5 {
        // R105 移位数超出位宽
        int z = 64
        println("{1 << z}")
    }
    if TRAP == 6 {
        // R106 浮点结果不是有限值
        float f = 1.0
        float zero = 0.0
        println("{f / zero}")
    }
    if TRAP == 7 {
        // R107 转换失败：字符串转数字（演示 strconv.parseInt 处理无效输入）
        int n = strconv.parseInt("abc", 10)
        println("parseInt(\"abc\", 10) = {n}（无效输入返回 0，不崩溃）")
    }
    return 0
}
