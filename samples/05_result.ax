// 05_result.ax —— 错误是值：result<T> + try + throw + match
//
// 没有第二套异常机制，没有错误码返回值。失败用 result 表达，
// `try` 相当于"不处理就往上传"，`match` 强制你处理两种情况。
// （要在一段代码里就地捕获，用 try/catch/finally —— 见 11_try_catch.ax）
//
//   axc run samples/05_result.ax

result<int> divide(int a, int b) {
    if b == 0 {
        throw error.Invalid("除数不能是 0")
    }
    return ok(a / b)
}

// `try` 把 result 里的值取出来；失败则立刻把错误传给调用者
result<int> divide_twice(int a, int b, int c) {
    int x = divide(a, b) try
    int y = divide(x, c) try
    return ok(y)
}

int main() {
    // ---- 成功路径 ----
    match divide(100, 4) {
        ok(v) => println("100 / 4 = {v}"),
        fail(e) => println("失败：{e.msg}"),
    }

    // ---- 失败路径：业务错误是值，不会崩，退出码仍是 0 ----
    match divide(1, 0) {
        ok(v) => println("不会走到这里"),
        fail(e) => println("捕获到：{e.msg}"),
    }

    // ---- try 链式传播：第二层除零，第一层的错误一路上浮 ----
    match divide_twice(8, 2, 0) {
        ok(v) => println("结果 {v}"),
        fail(e) => println("链式传播：{e.msg}"),
    }

    // ---- main 自己返回 result 时，try 会直接结束程序 ----
    int good = divide(9, 3) try
    println("9 / 3 = {good}")
    return 0
}
