// test_step.ax —— 验证 range.Step(n) 步进循环
int main() {
    // 半开区间步进：0, 2, 4, 6, 8
    int sum = 0
    for i in (0..10).Step(2) {
        sum = sum + i
    }
    println("0..10 Step(2) 求和 = {sum}")

    // 闭区间步进：1, 4, 7, 10
    int sum2 = 0
    for i in (1..=10).Step(3) {
        sum2 = sum2 + i
    }
    println("1..=10 Step(3) 求和 = {sum2}")

    // 步长为 1 等价于普通 range
    int sum3 = 0
    for i in (0..5).Step(1) {
        sum3 = sum3 + i
    }
    println("0..5 Step(1) 求和 = {sum3}")

    return 0
}
